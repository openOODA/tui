// # llm_ollama.oo - Ollama (local) Provider
//
// Logline: Calls Ollama's /api/chat endpoint. No auth. Default URL http://localhost:11434/api/chat.
//
// Setup: Imports llm.oo for the LlmProvider type. Uses std/net/http_client.oo.
//
// Beats:
//   1. Build request body: {model, messages=[{role:user, content:prompt}], stream=false}.
//   2. No auth headers.
//   3. POST and parse response, extract message.content.

import "std/net/http_client.oo";
import "llm.oo";

pub fn llm_ollama_complete(http: &TcpCap, p: LlmProvider, prompt: String) -> Result[String, String] {
    let body: String = "{\"model\":\"" + p.model + "\",\"stream\":false,\"messages\":[{\"role\":\"user\",\"content\":\"" + escape(prompt) + "\"}]}";
    let r: Result[String, String] = http_client_post(http, p.base_url, "application/json", body);
    let raw: String = match r { Ok(s) => s, Err(e) => return Err("ollama post: " + e); };
    return Ok(extract_message(raw));
}

fn escape(s: String) -> String {
    let mut out: String = "";
    let n: Int = chars_len(s);
    let mut i: Int = 0;
    while i < n {
        let c: String = str_slice(s, i, i + 1);
        if c == "\"" { out = out + "\\\""; }
        else if c == "\\" { out = out + "\\\\"; }
        else if c == "\n" { out = out + "\\n"; }
        else { out = out + c; }
        i = i + 1;
    }
    return out;
}

fn extract_message(raw: String) -> String {
    let n: Int = chars_len(raw);
    let mut i: Int = 0;
    let mut out: String = "";
    let mut in_msg: Bool = false;
    while i < n {
        if !in_msg && str_slice(raw, i, i + 10) == "\"content\":\"" {
            in_msg = true;
            i = i + 10;
        } else if in_msg {
            let c: String = str_slice(raw, i, i + 1);
            if c == "\"" { in_msg = false; }
            else { out = out + c; }
            i = i + 1;
        } else {
            i = i + 1;
        }
    }
    return out;
}
