// # slash_extra.oo - Slash Commands (split 2 of 2)
//
// Logline: Holds the remaining 9 slash commands. Imported by slash.oo. Exposes one function per command: slash_extra_<cmd>.
//
// Setup: Imports app.oo for AppState. Pure functions; each takes the current state and returns a new state.
//
// Beats:
//   1. /resume, /rename, /settings, /status, /btw, /team, /theme, /help, /exit, /quit.

import "app.oo";
import "btw.oo";

pub fn slash_extra_resume(state: AppState, args: String) -> AppState {
    println("resume: specify a session id to load");
    return state;
}

pub fn slash_extra_rename(state: AppState, args: String) -> AppState {
    let mut s: AppState = state;
    if args == "" {
        println("rename: specify a new name");
        return s;
    }
    s.session.name = str_trim(args);
    println("rename: session renamed to " + s.session.name);
    return s;
}

pub fn slash_extra_settings(state: AppState) -> AppState {
    println("settings:");
    println("  default_provider = " + state.cfg.default_provider);
    println("  default_model = " + state.cfg.default_model);
    println("  permission_mode = " + state.cfg.permission_mode);
    println("  compact_threshold = " + state.cfg.compact_threshold);
    println("  theme = " + state.cfg.theme);
    println("  teamwork_agents = " + int_to_str(state.cfg.teamwork_agents));
    println("  yolo = " + bool_str(state.yolo));
    println("  teamwork = " + bool_str(state.teamwork));
    return state;
}

pub fn slash_extra_status(state: AppState) -> AppState {
    println("status:");
    let mode: String = if state.teamwork { "teamwork" } else { "code" };
    println("  mode = " + mode);
    println("  provider = " + state.provider_name);
    println("  model = " + state.model_name);
    println("  cwd = " + state.session.cwd);
    println("  session = " + state.session.sid + " (" + state.session.name + ")");
    println("  yolo = " + bool_str(state.yolo));
    let turns: Int = loop_turn_count(state.loop_state);
    println("  turns = " + int_to_str(turns));
    return state;
}

pub fn slash_extra_btw(state: AppState, args: String) -> AppState {
    let mut s: AppState = state;
    if args == "" {
        println("btw: specify a question");
        return s;
    }
    let wrapped: String = btw_wrap(args);
    s.loop_state = loop_append_side(s.loop_state, wrapped);
    println("btw: queued side question");
    return s;
}

pub fn slash_extra_team(state: AppState, args: String) -> AppState {
    let mut s: AppState = state;
    if args == "" {
        println("team: subcommands: agent-N <p>:<m>, pin, auto, add [N], remove <N>, stop, status");
        return s;
    }
    let sub: String = str_trim(args);
    if sub == "stop" {
        s.teamwork = false;
        println("team: stopped");
        return s;
    }
    if sub == "status" {
        println("team: teamwork=" + bool_str(s.teamwork));
        return s;
    }
    println("team: subcommand not yet implemented in v0.1: " + sub);
    return s;
}

pub fn slash_extra_theme(state: AppState, args: String) -> AppState {
    let mut s: AppState = state;
    if args == "" {
        println("theme: active = " + s.theme);
        return s;
    }
    s.theme = str_trim(args);
    println("theme: switched to " + s.theme);
    return s;
}

pub fn slash_extra_help(state: AppState) -> AppState {
    println("commands:");
    println("  /login [provider]    /logout [provider]    /providers");
    println("  /model [provider:model]");
    println("  /plan [text]         /goal [text]");
    println("  /clear               /compact");
    println("  /resume [id]         /rename <name>");
    println("  /settings            /status");
    println("  /btw <question>");
    println("  /team <sub>          /theme [name]");
    println("  /help                /exit   /quit");
    return state;
}

pub fn slash_extra_exit(state: AppState) -> AppState {
    println("exit: session " + state.session.sid + " saved");
    return state;
}

pub fn slash_extra_unknown(state: AppState, cmd: String) -> AppState {
    println("unknown command: " + cmd);
    return state;
}

fn bool_str(b: Bool) -> String {
    if b { return "on"; }
    return "off";
}

fn int_to_str(n: Int) -> String {
    if n < 0 { return "0"; }
    if n == 0 { return "0"; }
    let digits: String = "0123456789";
    let mut v: Int = n;
    let mut rev: String = "";
    while v > 0 { let d: Int = v - (v / 10) * 10; rev = rev + char_at(digits, d); v = v / 10; }
    let mut out: String = "";
    let mut k: Int = chars_len(rev) - 1;
    while k >= 0 { out = out + char_at(rev, k); k = k - 1; }
    return out;
}
