// # minimax - Dark Neutral + Amber Accent Theme
//
// Logline: A second theme for tui, modeled on minimax Code's visual identity. Near-black background, neutral grays for chrome, amber accent for emphasis.
//
// Setup: Exports theme_minimax_token() and theme_minimax_name(). Consumed by theme.oo loader via `import "themes/minimax.oo";`.
//
// Beats:
//   1. Define the 14 hex vars sourced from a hand-picked dark-neutral palette.
//   2. Map all 47 semantic tokens to the vars.
//   3. Return the theme name "minimax".

// Source hex codes. Hand-tuned dark neutral with amber accent.
// NOTE: private fns use the mm_ prefix because oodac merges same-named
// private fns across co-compiled modules; themes/ must keep them unique.
fn mm_v_amber() -> String { return "#E0A040"; }
fn mm_v_amber_dim() -> String { return "#A07020"; }
fn mm_v_neutral_text() -> String { return "#E5E5E5"; }
fn mm_v_neutral_muted() -> String { return "#9A9A9A"; }
fn mm_v_neutral_dim() -> String { return "#5A5A5A"; }
fn mm_v_neutral_bg() -> String { return "#0E0E10"; }
fn mm_v_panel_bg() -> String { return "#1A1A1D"; }
fn mm_v_user_bg() -> String { return "#16161A"; }
fn mm_v_tool_pending() -> String { return "#1A1A22"; }
fn mm_v_tool_success() -> String { return "#10161A"; }
fn mm_v_tool_error() -> String { return "#1F1014"; }
fn mm_v_accent_blue() -> String { return "#7AB8FF"; }
fn mm_v_accent_red() -> String { return "#E07060"; }
fn mm_v_accent_green() -> String { return "#7AC888"; }

// Core UI tokens
fn mm_t_accent() -> String { return mm_v_amber(); }
fn mm_t_border() -> String { return mm_v_neutral_dim(); }
fn mm_t_border_accent() -> String { return mm_v_amber(); }
fn mm_t_border_muted() -> String { return mm_v_neutral_dim(); }
fn mm_t_success() -> String { return mm_v_accent_green(); }
fn mm_t_error() -> String { return mm_v_accent_red(); }
fn mm_t_warning() -> String { return mm_v_amber(); }
fn mm_t_muted() -> String { return mm_v_neutral_muted(); }
fn mm_t_dim() -> String { return mm_v_neutral_dim(); }
fn mm_t_text() -> String { return mm_v_neutral_text(); }
fn mm_t_thinking_text() -> String { return mm_v_neutral_muted(); }

// Backgrounds and content tokens
fn mm_t_selected_bg() -> String { return mm_v_panel_bg(); }
fn mm_t_scrollbar_track() -> String { return mm_v_neutral_dim(); }
fn mm_t_scrollbar_thumb() -> String { return mm_v_amber_dim(); }
fn mm_t_user_message_bg() -> String { return mm_v_user_bg(); }
fn mm_t_user_message_text() -> String { return mm_v_neutral_text(); }
fn mm_t_custom_message_bg() -> String { return mm_v_panel_bg(); }
fn mm_t_custom_message_text() -> String { return mm_v_neutral_text(); }
fn mm_t_custom_message_label() -> String { return mm_v_amber(); }
fn mm_t_tool_pending_bg() -> String { return mm_v_tool_pending(); }
fn mm_t_tool_success_bg() -> String { return mm_v_tool_success(); }
fn mm_t_tool_error_bg() -> String { return mm_v_tool_error(); }
fn mm_t_tool_title() -> String { return mm_v_amber(); }
fn mm_t_tool_output() -> String { return mm_v_neutral_muted(); }

// Markdown tokens
fn mm_t_md_heading() -> String { return mm_v_amber(); }
fn mm_t_md_link() -> String { return mm_v_accent_blue(); }
fn mm_t_md_link_url() -> String { return mm_v_neutral_dim(); }
fn mm_t_md_code() -> String { return mm_v_accent_green(); }
fn mm_t_md_code_block() -> String { return mm_v_neutral_text(); }
fn mm_t_md_code_block_border() -> String { return mm_v_amber_dim(); }
fn mm_t_md_list_bullet() -> String { return mm_v_amber(); }

// Tool diff tokens
fn mm_t_tool_diff_added() -> String { return mm_v_accent_green(); }
fn mm_t_tool_diff_removed() -> String { return mm_v_accent_red(); }
fn mm_t_tool_diff_context() -> String { return mm_v_neutral_muted(); }

// Syntax tokens
fn mm_t_syntax_comment() -> String { return mm_v_neutral_muted(); }
fn mm_t_syntax_keyword() -> String { return mm_v_amber(); }
fn mm_t_syntax_function() -> String { return mm_v_accent_blue(); }
fn mm_t_syntax_variable() -> String { return mm_v_neutral_text(); }
fn mm_t_syntax_string() -> String { return mm_v_accent_green(); }
fn mm_t_syntax_number() -> String { return mm_v_accent_red(); }
fn mm_t_syntax_type() -> String { return mm_v_accent_blue(); }
fn mm_t_syntax_operator() -> String { return mm_v_amber(); }
fn mm_t_syntax_punctuation() -> String { return mm_v_neutral_muted(); }

// Thinking level tokens
fn mm_t_thinking_off() -> String { return mm_v_neutral_dim(); }
fn mm_t_thinking_minimal() -> String { return mm_v_neutral_muted(); }
fn mm_t_thinking_low() -> String { return mm_v_accent_green(); }
fn mm_t_thinking_medium() -> String { return mm_v_accent_green(); }
fn mm_t_thinking_high() -> String { return mm_v_amber_dim(); }
fn mm_t_thinking_xhigh() -> String { return mm_v_amber(); }
fn mm_t_thinking_max() -> String { return mm_v_accent_red(); }
fn mm_t_bash_mode() -> String { return mm_v_accent_green(); }

// Theme record. Returns the hex code for any of the 47 semantic tokens.
pub fn theme_minimax_token(token: String) -> String {
    if token == "accent" { return mm_t_accent(); }
    if token == "border" { return mm_t_border(); }
    if token == "borderAccent" { return mm_t_border_accent(); }
    if token == "borderMuted" { return mm_t_border_muted(); }
    if token == "success" { return mm_t_success(); }
    if token == "error" { return mm_t_error(); }
    if token == "warning" { return mm_t_warning(); }
    if token == "muted" { return mm_t_muted(); }
    if token == "dim" { return mm_t_dim(); }
    if token == "text" { return mm_t_text(); }
    if token == "thinkingText" { return mm_t_thinking_text(); }
    if token == "selectedBg" { return mm_t_selected_bg(); }
    if token == "scrollbarTrack" { return mm_t_scrollbar_track(); }
    if token == "scrollbarThumb" { return mm_t_scrollbar_thumb(); }
    if token == "userMessageBg" { return mm_t_user_message_bg(); }
    if token == "userMessageText" { return mm_t_user_message_text(); }
    if token == "customMessageBg" { return mm_t_custom_message_bg(); }
    if token == "customMessageText" { return mm_t_custom_message_text(); }
    if token == "customMessageLabel" { return mm_t_custom_message_label(); }
    if token == "toolPendingBg" { return mm_t_tool_pending_bg(); }
    if token == "toolSuccessBg" { return mm_t_tool_success_bg(); }
    if token == "toolErrorBg" { return mm_t_tool_error_bg(); }
    if token == "toolTitle" { return mm_t_tool_title(); }
    if token == "toolOutput" { return mm_t_tool_output(); }
    if token == "mdHeading" { return mm_t_md_heading(); }
    if token == "mdLink" { return mm_t_md_link(); }
    if token == "mdLinkUrl" { return mm_t_md_link_url(); }
    if token == "mdCode" { return mm_t_md_code(); }
    if token == "mdCodeBlock" { return mm_t_md_code_block(); }
    if token == "mdCodeBlockBorder" { return mm_t_md_code_block_border(); }
    if token == "mdListBullet" { return mm_t_md_list_bullet(); }
    if token == "toolDiffAdded" { return mm_t_tool_diff_added(); }
    if token == "toolDiffRemoved" { return mm_t_tool_diff_removed(); }
    if token == "toolDiffContext" { return mm_t_tool_diff_context(); }
    if token == "syntaxComment" { return mm_t_syntax_comment(); }
    if token == "syntaxKeyword" { return mm_t_syntax_keyword(); }
    if token == "syntaxFunction" { return mm_t_syntax_function(); }
    if token == "syntaxVariable" { return mm_t_syntax_variable(); }
    if token == "syntaxString" { return mm_t_syntax_string(); }
    if token == "syntaxNumber" { return mm_t_syntax_number(); }
    if token == "syntaxType" { return mm_t_syntax_type(); }
    if token == "syntaxOperator" { return mm_t_syntax_operator(); }
    if token == "syntaxPunctuation" { return mm_t_syntax_punctuation(); }
    if token == "thinkingOff" { return mm_t_thinking_off(); }
    if token == "thinkingMinimal" { return mm_t_thinking_minimal(); }
    if token == "thinkingLow" { return mm_t_thinking_low(); }
    if token == "thinkingMedium" { return mm_t_thinking_medium(); }
    if token == "thinkingHigh" { return mm_t_thinking_high(); }
    if token == "thinkingXhigh" { return mm_t_thinking_xhigh(); }
    if token == "thinkingMax" { return mm_t_thinking_max(); }
    if token == "bashMode" { return mm_t_bash_mode(); }
    return mm_t_text();
}

pub fn theme_minimax_name() -> String {
    return "minimax";
}
