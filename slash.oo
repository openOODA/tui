// # slash.oo - Slash Command Dispatcher (split 1 of 2)
//
// Logline: Dispatches the first half of 17 slash commands. Slash commands 9-17 live in slash_extra.oo.
//
// Setup: Imports app.oo for AppState, config.oo for config mutations. The second half of the commands is in slash_extra.oo.
//
// Beats:
//   1. /login, /logout, /providers, /model, /plan, /goal.
//   2. /clear, /compact.
//   3. Common helpers: extract_cmd, extract_args.

import "app.oo";
import "compact.oo";
import "config.oo";
import "plan.oo";
import "slash_extra.oo";
import "version.oo";

pub fn slash_run(state: AppState, line: String) -> AppState {
    let s0: AppState = app_clear_output(state);
    let cmd: String = extract_cmd(line);
    let args: String = extract_args(line, cmd);
    if cmd == "/login" { return cmd_login(s0, args); }
    if cmd == "/logout" { return cmd_logout(s0, args); }
    if cmd == "/providers" { return cmd_providers(s0); }
    if cmd == "/model" { return cmd_model(s0, args); }
    if cmd == "/provider" { return cmd_model(s0, args); }
    if cmd == "/plan" { return cmd_plan(s0, args); }
    if cmd == "/goal" { return cmd_goal(s0, args); }
    if cmd == "/clear" { return cmd_clear(s0); }
    if cmd == "/compact" { return cmd_compact(s0); }
    if cmd == "/cwd" { return cmd_cwd(s0, args); }
    if cmd == "/version" { return app_say(s0, "ooda-tui " + ooda_tui_version()); }
    if cmd == "/resume" { return slash_extra_resume(s0, args); }
    if cmd == "/rename" { return slash_extra_rename(s0, args); }
    if cmd == "/settings" { return slash_extra_settings(s0); }
    if cmd == "/status" { return slash_extra_status(s0); }
    if cmd == "/btw" { return slash_extra_btw(s0, args); }
    if cmd == "/team" { return slash_extra_team(s0, args); }
    if cmd == "/theme" { return slash_extra_theme(s0, args); }
    if cmd == "/help" { return slash_extra_help(s0); }
    if cmd == "/exit" { return slash_extra_exit(s0); }
    if cmd == "/quit" { return slash_extra_exit(s0); }
    return slash_extra_unknown(s0, cmd);
}

fn extract_cmd(line: String) -> String {
    let n: Int = chars_len(line);
    let mut i: Int = 0;
    let mut out: String = "";
    while i < n {
        let c: String = str_slice(line, i, i + 1);
        if c == " " || c == "\t" { return out; }
        out = out + c;
        i = i + 1;
    }
    return out;
}

fn extract_args(line: String, cmd: String) -> String {
    let n: Int = chars_len(line);
    let mut i: Int = chars_len(cmd);
    while i < n {
        let c: String = str_slice(line, i, i + 1);
        if c != " " && c != "\t" { return str_trim(str_slice(line, i, n)); }
        i = i + 1;
    }
    return "";
}

fn cmd_login(state: AppState, args: String) -> AppState {
    let mut s: AppState = state;
    if args == "" {
        return app_say(s, "login: specify a provider. configured: " + provider_names(s.cfg));
    }
    let name: String = first_word(args);
    let key: String = rest_words(args, name);
    if config_has_provider(s.cfg, name) {
        return app_say(s, "login: provider " + name + " already configured");
    }
    let ptype: String = if name == "ollama" { "local" } else { "cloud" };
    s.cfg = config_add_provider(s.cfg, name, ptype, key, "", list_new());
    s.provider_name = name;
    if key == "" {
        return app_say(s, "login: added provider " + name + " (key from env or /login " + name + " <key>)");
    }
    return app_say(s, "login: added provider " + name);
}

fn cmd_logout(state: AppState, args: String) -> AppState {
    let mut s: AppState = state;
    if args == "" {
        return app_say(s, "logout: specify a provider");
    }
    s.cfg = config_remove_provider(s.cfg, str_trim(args));
    return app_say(s, "logout: removed " + str_trim(args));
}

fn first_word(s: String) -> String {
    let n: Int = chars_len(s);
    let mut i: Int = 0;
    let mut out: String = "";
    while i < n {
        let c: String = str_slice(s, i, i + 1);
        if c == " " || c == "\t" { return out; }
        out = out + c;
        i = i + 1;
    }
    return out;
}

fn rest_words(s: String, first: String) -> String {
    return str_trim(str_slice(s, chars_len(first), chars_len(s)));
}

fn cmd_cwd(state: AppState, args: String) -> AppState {
    let mut s: AppState = state;
    if args == "" { return app_say(s, "cwd: " + s.session.cwd); }
    s.session.cwd = str_trim(args);
    return app_say(s, "cwd: " + s.session.cwd);
}

fn provider_names(cfg: Config) -> String {
    let mut out: String = "";
    let n: Int = list_len(cfg.providers);
    let mut i: Int = 0;
    while i < n {
        let p: Provider = list_get(cfg.providers, i);
        if i > 0 { out = out + ", "; }
        out = out + p.name;
        i = i + 1;
    }
    return out;
}

fn cmd_providers(state: AppState) -> AppState {
    let n: Int = list_len(state.cfg.providers);
    let mut s: AppState = app_say(state, "providers: " + int_to_str(n) + " configured");
    let mut i: Int = 0;
    while i < n {
        let p: Provider = list_get(state.cfg.providers, i);
        s = app_say(s, "  " + p.name + " (" + p.ptype + ") models=" + int_to_str(list_len(p.models)));
        i = i + 1;
    }
    return s;
}

fn cmd_model(state: AppState, args: String) -> AppState {
    let mut s: AppState = state;
    if args == "" {
        return app_say(s, "model: current " + s.provider_name + "/" + s.model_name);
    }
    let colon: Int = str_index_of(args, ":");
    if colon < 0 {
        s.provider_name = str_trim(args);
        return app_say(s, "model: switched provider to " + s.provider_name);
    }
    s.provider_name = str_trim(str_slice(args, 0, colon));
    s.model_name = str_trim(str_slice(args, colon + 1, chars_len(args)));
    return app_say(s, "model: switched to " + s.provider_name + "/" + s.model_name);
}

fn cmd_plan(state: AppState, args: String) -> AppState {
    let mut s: AppState = state;
    if args == "" { return app_say(s, "plan: " + s.loop_state.plan); }
    s.loop_state.plan = plan_set(s.loop_state.plan, args);
    return app_say(s, "plan: set");
}

fn cmd_goal(state: AppState, args: String) -> AppState {
    let mut s: AppState = state;
    if args == "" { return app_say(s, "goal: " + s.loop_state.goal); }
    s.loop_state.goal = goal_set(s.loop_state.goal, args);
    return app_say(s, "goal: set");
}

fn cmd_clear(state: AppState) -> AppState {
    let mut s: AppState = state;
    let plan_save: String = s.loop_state.plan;
    let goal_save: String = s.loop_state.goal;
    s.loop_state = loop_state_new();
    s.loop_state.plan = plan_save;
    s.loop_state.goal = goal_save;
    return app_say(s, "clear: context cleared, session preserved");
}

fn cmd_compact(state: AppState) -> AppState {
    let mut s: AppState = state;
    if compact_idempotent(s.loop_state) {
        return app_say(s, "compact: no-op (already compacted)");
    }
    s.loop_state = compact_run(s.loop_state, "[summary placeholder]");
    return app_say(s, "compact: done");
}

fn int_to_str(n: Int) -> String {
    if n < 0 { return "0"; }
    if n == 0 { return "0"; }
    let digits: String = "0123456789";
    let mut v: Int = n;
    let mut rev: String = "";
    while v > 0 { let d: Int = v - (v / 10) * 10; rev = rev + char_at(digits, d); v = v / 10; }
    let mut out: String = "";
    let mut k: Int = chars_len(rev) - 1;
    while k >= 0 { out = out + char_at(rev, k); k = k - 1; }
    return out;
}
