// # qa/theme_swap.oo - Theme Swap Probe
//
// Logline: Assert theme_color("1982", token) and theme_color("minimax", token) return different hex codes for accent tokens (so users see a real visual change on /theme).
//
// Setup: In-process. Checks a curated subset of "accent" tokens where the two palettes are intentionally distinct.
//
// Beats:
//   1. For each accent token (accent, error, success, mdHeading, toolDiffAdded, toolDiffRemoved) assert 1982 != minimax.
//   2. For muted/dim tokens assert the two themes return different grays (the palettes are different neutral families).
//   3. Print pass/fail.

import "theme.oo";

pub fn qa_theme_swap_run() -> Int {
    let mut pass: Int = 0;
    let mut fail: Int = 0;
    let tokens: String = "accent\1error\1success\1mdHeading\1toolDiffAdded\1toolDiffRemoved\1muted\1dim";
    let n: Int = count_tokens(tokens);
    let mut i: Int = 0;
    while i < n {
        let tok: String = get_token(tokens, i);
        let a: String = theme_color("1982", tok);
        let b: String = theme_color("minimax", tok);
        if a != b { pass = pass + 1; }
        else { fail = fail + 1; println("FAIL: 1982 == minimax for token=" + tok); }
        i = i + 1;
    }
    println("qa/theme_swap: pass=" + int_to_str(pass) + " fail=" + int_to_str(fail));
    if fail > 0 { return 1; }
    return 0;
}

fn count_tokens(s: String) -> Int {
    if s == "" { return 0; }
    let mut n: Int = 1;
    let len: Int = chars_len(s);
    let mut i: Int = 0;
    while i < len {
        if char_at(s, i) == "\1" { n = n + 1; }
        i = i + 1;
    }
    return n;
}

fn get_token(s: String, idx: Int) -> String {
    let len: Int = chars_len(s);
    let mut cur: Int = 0;
    let mut out: String = "";
    let mut i: Int = 0;
    while i < len {
        if char_at(s, i) == "\1" {
            if cur == idx { return out; }
            cur = cur + 1;
            out = "";
        } else {
            out = out + char_at(s, i);
        }
        i = i + 1;
    }
    if cur == idx { return out; }
    return "";
}

fn int_to_str(n: Int) -> String {
    if n < 0 { return "0"; }
    if n == 0 { return "0"; }
    let digits: String = "0123456789";
    let mut v: Int = n;
    let mut rev: String = "";
    while v > 0 {
        let d: Int = v - (v / 10) * 10;
        rev = rev + char_at(digits, d);
        v = v / 10;
    }
    let mut out: String = "";
    let mut k: Int = chars_len(rev) - 1;
    while k >= 0 {
        out = out + char_at(rev, k);
        k = k - 1;
    }
    return out;
}

pub fn main(bind: &BindCap, fs_r: &FsReadCap, fs_w: &FsWriteCap, sys: &ProcessCap, sys_cap: &SysCap, env: &EnvCap, time: &TimeCap, alloc: &AllocCap, thread: &ThreadCap, args: List[String]) -> Result[Int, String] {
    let st: Int = qa_theme_swap_run();
    if st != 0 { return Err("qa/theme_swap failed"); }
    return Ok(0);
}
