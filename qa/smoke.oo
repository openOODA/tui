// # qa/smoke - End-to-End Smoke Test
//
// Logline: Top-level smoke test. Verifies the binary builds, runs --help, --version, and basic flag combinations.
//
// Setup: Spawns dist/ooda-tui with various argv and asserts the output.
//
// Beats:
//   1. --help prints help text.
//   2. --version prints v0.1.0.
//   3. With OODACODEX set and --teamwork, prints the readiness banner.
//   4. With an unknown flag, exits nonzero.

import "std/fs/process/process.oo";

fn main(bind: &BindCap, fs_r: &FsReadCap, fs_w: &FsWriteCap, sys: &ProcessCap, sys_cap: &SysCap, env: &EnvCap, time: &TimeCap, alloc: &AllocCap, thread: &ThreadCap, args: List[String]) -> Result[Int, String] {
    println("qa/smoke: starting end-to-end smoke");
    let mut pass: Int = 0;
    let mut fail: Int = 0;
    let r1: Result[String, String> = process_exec(sys, "./dist/ooda-tui --help");
    if r1.is_ok() { pass = pass + 1; println("PASS: --help"); }
    else { fail = fail + 1; println("FAIL: --help"); }
    let r2: Result<String, String> = process_exec(sys, "./dist/ooda-tui --version");
    if r2.is_ok() { pass = pass + 1; println("PASS: --version"); }
    else { fail = fail + 1; println("FAIL: --version"); }
    let r3: Result<String, String> = process_exec(sys, "OODACODEX=/tmp/openOODA/northstar.oot ./dist/ooda-tui --teamwork --yolo");
    if r3.is_ok() { pass = pass + 1; println("PASS: teamwork+yolo ready banner"); }
    else { fail = fail + 1; println("FAIL: teamwork+yolo"); }
    let r4: Result<String, String> = process_exec(sys, "./dist/ooda-tui --bogus");
    if r4.is_ok() { fail = fail + 1; println("FAIL: bogus flag should error"); }
    else { pass = pass + 1; println("PASS: bogus flag errors"); }
    println("qa/smoke: pass=" + int_to_str(pass) + " fail=" + int_to_str(fail));
    if fail > 0 { return Err("qa/smoke: failures"); }
    return Ok(0);
}
