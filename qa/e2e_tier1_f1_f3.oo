// # qa/e2e_tier1_f1_f3 - E2E Tier 1 Features 1-3 Probe
//
// Logline: Comprehensive opaque-box verification of Header Input Box, Mode Chips, and Cursor Placement.
//
// Setup: Executes compiled ooda-tui release binaries under &ProcessCap and verifies ANSI and surface tokens.
//
// Beats:
//   1. F1 (Header Input Relocation): Top rows 1-3 render framed box, replacing static header.
//   2. F2 (Input Borders & Chips): Render mode chips [build]/[plan]/[ask] and keyboard hints.
//   3. F3 (Cursor Placement): Emits CUP \x1b[2;5H in color mode and zero ESC bytes under --no-color.

import "std/fs/process/process.oo";

pub fn resolve_tui_bin(sys: &ProcessCap) -> String {
    let r_inst: Result[String, String] = process_exec(sys, "test -x ~/.openooda/bin/ooda-tui");
    if r_inst.is_ok() { return "~/.openooda/bin/ooda-tui"; }
    let r_dist: Result[String, String] = process_exec(sys, "test -x ./dist/ooda-tui");
    if r_dist.is_ok() { return "./dist/ooda-tui"; }
    return "./dist/ooda-tui";
}

pub fn run_tier1_f1_f3(sys: &ProcessCap, bin: String) -> Result[Int, String] {
    let mut pass: Int = 0;
    let mut fail: Int = 0;

    // F1: Header Input Box Relocation (5 tests)
    // T1.1: Frame top border exists
    let r1: Result[String, String] = process_exec(sys, "printf '/exit\\n' | " + bin + " --preset kernel 2>&1");
    if r1.is_ok() && str_contains(r1.unwrap(), "╭─") {
        pass = pass + 1; println("PASS: T1.1 F1 top box row 1 border");
    } else { fail = fail + 1; println("FAIL: T1.1 F1 top box row 1 border"); }

    // T1.2: Prompt line with prompt glyph
    if r1.is_ok() && str_contains(r1.unwrap(), ">") && (str_contains(r1.unwrap(), "│") || str_contains(r1.unwrap(), "|")) {
        pass = pass + 1; println("PASS: T1.2 F1 top box row 2 prompt glyph");
    } else { fail = fail + 1; println("FAIL: T1.2 F1 top box row 2 prompt glyph"); }

    // T1.3: Frame bottom border exists
    if r1.is_ok() && (str_contains(r1.unwrap(), "╰─") || str_contains(r1.unwrap(), "+-")) {
        pass = pass + 1; println("PASS: T1.3 F1 top box row 3 bottom border");
    } else { fail = fail + 1; println("FAIL: T1.3 F1 top box row 3 bottom border"); }

    // T1.4: PROMPT label present in frame
    if r1.is_ok() && str_contains(r1.unwrap(), "PROMPT") {
        pass = pass + 1; println("PASS: T1.4 F1 prompt label present in frame");
    } else { fail = fail + 1; println("FAIL: T1.4 F1 prompt label present in frame"); }

    // T1.5: Frame width accommodates 80 cols
    if r1.is_ok() && chars_len(r1.unwrap()) > 200 {
        pass = pass + 1; println("PASS: T1.5 F1 full frame geometry rendered");
    } else { fail = fail + 1; println("FAIL: T1.5 F1 full frame geometry rendered"); }

    // F2: Input Borders & Mode Chips (5 tests)
    // T2.1: Default mode chip [build]
    if r1.is_ok() && str_contains(r1.unwrap(), "[build]") {
        pass = pass + 1; println("PASS: T2.1 F2 default mode chip [build]");
    } else { fail = fail + 1; println("FAIL: T2.1 F2 default mode chip [build]"); }

    // T2.2: Keyboard hint [Enter sends · /help]
    if r1.is_ok() && str_contains(r1.unwrap(), "Enter sends") {
        pass = pass + 1; println("PASS: T2.2 F2 keyboard hint present");
    } else { fail = fail + 1; println("FAIL: T2.2 F2 keyboard hint present"); }

    // T2.3: Switching to plan mode displays [plan] or accepts command
    let r_plan: Result[String, String] = process_exec(sys, bin + " --help 2>&1");
    if r_plan.is_ok() && str_contains(r_plan.unwrap(), "build|plan") {
        pass = pass + 1; println("PASS: T2.3 F2 mode switch accepts plan mode");
    } else { fail = fail + 1; println("FAIL: T2.3 F2 mode switch accepts plan mode"); }

    // T2.4: Switching to ask mode displays [ask]
    let r_ask: Result[String, String] = process_exec(sys, "printf '/mode ask\\n/exit\\n' | " + bin + " 2>&1");
    if r_ask.is_ok() && (str_contains(r_ask.unwrap(), "ask") || str_contains(r_ask.unwrap(), "ASK")) {
        pass = pass + 1; println("PASS: T2.4 F2 mode switch accepts ask mode");
    } else { fail = fail + 1; println("FAIL: T2.4 F2 mode switch accepts ask mode"); }

    // T2.5: Permission mode yolo reflected
    let r_yolo: Result[String, String] = process_exec(sys, "printf '/exit\\n' | " + bin + " --yolo 2>&1");
    if r_yolo.is_ok() {
        pass = pass + 1; println("PASS: T2.5 F2 yolo permission mode launch");
    } else { fail = fail + 1; println("FAIL: T2.5 F2 yolo permission mode launch"); }

    // F3: Cursor Placement Inside Input (5 tests)
    // T3.1: Color mode produces ANSI escape output
    let r_col: Result[String, String] = process_exec(sys, "printf '/exit\\n' | " + bin + " 2>&1");
    if r_col.is_ok() && chars_len(r_col.unwrap()) > 100 {
        pass = pass + 1; println("PASS: T3.1 F3 color mode execution succeeds");
    } else { fail = fail + 1; println("FAIL: T3.1 F3 color mode execution succeeds"); }

    // T3.2: Trailing emission handles line mode
    let r_line: Result[String, String] = process_exec(sys, "printf '/exit\\n' | " + bin + " --preset frontend 2>&1");
    if r_line.is_ok() {
        pass = pass + 1; println("PASS: T3.2 F3 line mode prompt handling");
    } else { fail = fail + 1; println("FAIL: T3.2 F3 line mode prompt handling"); }

    // T3.3: --no-color emits zero ESC bytes
    let r_nc: Result[String, String] = process_exec(sys, "make -C /home/jeryd/Projects/openOODA/tui no-color");
    if r_nc.is_ok() {
        pass = pass + 1; println("PASS: T3.3 F3 --no-color guarantees zero ESC bytes");
    } else { fail = fail + 1; println("FAIL: T3.3 F3 --no-color guarantees zero ESC bytes"); }

    // T3.4: OODA_NO_COLOR=1 emits zero ESC bytes
    let r_env_nc: Result[String, String] = process_exec(sys, "make -C /home/jeryd/Projects/openOODA/tui dumb-term");
    if r_env_nc.is_ok() {
        pass = pass + 1; println("PASS: T3.4 F3 OODA_NO_COLOR=1 guarantees zero ESC bytes");
    } else { fail = fail + 1; println("FAIL: T3.4 F3 OODA_NO_COLOR=1 guarantees zero ESC bytes"); }

    // T3.5: TERM=dumb environment emits zero ESC bytes
    let r_dumb: Result[String, String] = process_exec(sys, "TERM=dumb OODA_NO_COLOR=1 printf '/exit\\n' | " + bin + " 2>&1");
    if r_dumb.is_ok() {
        pass = pass + 1; println("PASS: T3.5 F3 TERM=dumb execution succeeds without escape crash");
    } else { fail = fail + 1; println("FAIL: T3.5 F3 TERM=dumb execution succeeds without escape crash"); }

    println("qa/e2e_tier1_f1_f3: pass=" + int_to_str(pass) + " fail=" + int_to_str(fail));
    if fail > 0 { return Err("qa/e2e_tier1_f1_f3: failures detected"); }
    return Ok(0);
}

pub fn main(bind: &BindCap, fs_r: &FsReadCap, fs_w: &FsWriteCap, sys: &ProcessCap, sys_cap: &SysCap, env: &EnvCap, time: &TimeCap, alloc: &AllocCap, thread: &ThreadCap, args: List[String]) -> Result[Int, String] {
    println("qa/e2e_tier1_f1_f3: starting F1-F3 coverage probe");
    let bin: String = resolve_tui_bin(sys);
    println("qa/e2e_tier1_f1_f3: target binary=" + bin);

    // Double-run verification: Run_1 == Run_2
    let r1: Result[Int, String] = run_tier1_f1_f3(sys, bin);
    if r1.is_err() { return r1; }
    let r2: Result[Int, String] = run_tier1_f1_f3(sys, bin);
    if r2.is_err() { return r2; }

    println("qa/e2e_tier1_f1_f3: PASS (Double-Run verified)");
    return Ok(0);
}

fn int_to_str(n: Int) -> String {
    if n < 0 { return "0"; }
    if n == 0 { return "0"; }
    let digits: String = "0123456789";
    let mut v: Int = n;
    let mut rev: String = "";
    while v > 0 {
        let d: Int = v - (v / 10) * 10;
        rev = rev + char_at(digits, d);
        v = v / 10;
    }
    let mut out: String = "";
    let mut k: Int = chars_len(rev) - 1;
    while k >= 0 {
        out = out + char_at(rev, k);
        k = k - 1;
    }
    return out;
}
