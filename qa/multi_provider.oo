// # qa/multi_provider - Multi-Provider Health Check
//
// Logline: Build multiple LlmProvider records, verify count, names, models, and flat config hydration.
//
// Setup: Uses llm.oo and config_io.oo for multi-provider record verification.
//
// Beats:
//   1. Build multiple LlmProvider records (anthropic, openai, ollama).
//   2. Verify provider count, names, models, and base URLs.
//   3. Hydrate flat configuration with environment fallback slots.
//   4. Validate provider fields and configurations.

import "llm.oo";
import "config_io.oo";

fn int_to_str(n: Int) -> String {
    if n < 0 { return "0"; }
    if n == 0 { return "0"; }
    let digits: String = "0123456789";
    let mut v: Int = n;
    let mut rev: String = "";
    while v > 0 {
        let d: Int = v - (v / 10) * 10;
        rev = rev + char_at(digits, d);
        v = v / 10;
    }
    let mut out: String = "";
    let mut k: Int = chars_len(rev) - 1;
    while k >= 0 {
        out = out + char_at(rev, k);
        k = k - 1;
    }
    return out;
}

fn main(bind: &BindCap, fs_r: &FsReadCap, fs_w: &FsWriteCap, sys: &ProcessCap, sys_cap: &SysCap, env: &EnvCap, time: &TimeCap, alloc: &AllocCap, thread: &ThreadCap, args: List[String]) -> Result[Int, String] {
    println("qa/multi_provider: starting multi-provider probe");
    let mut pass: Int = 0;
    let mut fail: Int = 0;

    let p_a: LlmProvider = provider_anthropic("anthropic", "sk-test", "claude-sonnet-4.5");
    let p_o: LlmProvider = provider_openai("openai", "sk-test", "gpt-5", "");
    let p_ol: LlmProvider = provider_ollama("ollama-1", "http://localhost:11434", "llama3");

    if provider_name(p_a) == "anthropic" { pass = pass + 1; println("PASS: anthropic name"); }
    else { fail = fail + 1; println("FAIL: anthropic name"); }

    if provider_name(p_o) == "openai" { pass = pass + 1; println("PASS: openai name"); }
    else { fail = fail + 1; println("FAIL: openai name"); }

    if provider_name(p_ol) == "ollama-1" { pass = pass + 1; println("PASS: ollama name"); }
    else { fail = fail + 1; println("FAIL: ollama name"); }

    if provider_model(p_a) == "claude-sonnet-4.5" && provider_model(p_o) == "gpt-5" && provider_model(p_ol) == "llama3" {
        pass = pass + 1; println("PASS: all provider models verified");
    } else { fail = fail + 1; println("FAIL: provider models mismatch"); }

    let flat: FlatCfg = flat_cfg_new();
    let hydrated: FlatCfg = config_hydrate_flat(flat, env);
    if hydrated.theme != "" {
        pass = pass + 1; println("PASS: flat config hydrated with default theme " + hydrated.theme);
    } else { fail = fail + 1; println("FAIL: flat config missing theme"); }

    println("qa/multi_provider: pass=" + int_to_str(pass) + " fail=" + int_to_str(fail));
    if fail > 0 { return Err("qa/multi_provider: failures"); }
    return Ok(0);
}
