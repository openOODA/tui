// # qa/e2e_tier2_b10_b12 - E2E Tier 2 Boundaries 10-12 Probe
//
// Logline: Boundary value analysis for Line Limits, Flag Parsing, and Binary Parity.
//
// Setup: Executes boundary checks against binary flag parsers, file system limits, and SHA-256 parity.
//
// Beats:
//   1. B10 (Line Limit & File Law): Verifies repository ceiling <=256 lines and rejects forbidden types.
//   2. B11 (Flag Boundaries): Verifies fail-closed exit code 2 on empty flag args and multi-bad flags.
//   3. B12 (Binary Parity): Verifies binary sizes, byte match, and deterministic digest consistency.

import "std/fs/process/process.oo";

pub fn resolve_tui_bin(sys: &ProcessCap) -> String {
    let r_inst: Result[String, String] = process_exec(sys, "test -x $OODA_HOME/.openooda/bin/ooda-tui");
    if r_inst.is_ok() { return "$OODA_HOME/.openooda/bin/ooda-tui"; }
    let r_dist: Result[String, String] = process_exec(sys, "test -x ./dist/ooda-tui");
    if r_dist.is_ok() { return "./dist/ooda-tui"; }
    return "./dist/ooda-tui";
}

pub fn run_tier2_b10_b12(sys: &ProcessCap, bin: String) -> Result[Int, String] {
    let mut pass: Int = 0;
    let mut fail: Int = 0;

    // B10: Line Limit & File Law Boundaries (5 tests)
    // T2_B10.1: Largest .oo file <= 256 lines
    let r_max: Result[String, String] = process_exec(sys, "max=0; for f in $(find $OODA_TUI_ROOT -name '*.oo'); do n=$(wc -l < \"$f\"); if [ $n -gt $max ]; then max=$n; fi; done; test $max -le 256");
    if r_max.is_ok() {
        pass = pass + 1; println("PASS: T2.1 B10 largest .oo file strictly <= 256 lines");
    } else { fail = fail + 1; println("FAIL: T2.1 B10 largest .oo file strictly <= 256 lines"); }

    // T2_B10.2: All qa/*.oo files <= 256 lines
    let r_qa_cap: Result[String, String] = process_exec(sys, "bad=0; for f in $(find $OODA_TUI_ROOT/qa -name '*.oo'); do n=$(wc -l < \"$f\"); if [ $n -gt 256 ]; then bad=$((bad+1)); fi; done; test $bad -eq 0");
    if r_qa_cap.is_ok() {
        pass = pass + 1; println("PASS: T2.2 B10 all qa probes satisfy 256-line ceiling");
    } else { fail = fail + 1; println("FAIL: T2.2 B10 all qa probes satisfy 256-line ceiling"); }

    // T2_B10.3: Zero .sh scripts in repo
    let r_sh: Result[String, String] = process_exec(sys, "test -z \"$(find $OODA_TUI_ROOT -name '*.sh' -not -path '*/.git/*')\"");
    if r_sh.is_ok() {
        pass = pass + 1; println("PASS: T2.3 B10 zero forbidden .sh scripts in repository");
    } else { fail = fail + 1; println("FAIL: T2.3 B10 zero forbidden .sh scripts in repository"); }

    // T2_B10.4: Zero .py scripts in repo
    let r_py: Result[String, String] = process_exec(sys, "test -z \"$(find $OODA_TUI_ROOT -name '*.py' -not -path '*/.git/*')\"");
    if r_py.is_ok() {
        pass = pass + 1; println("PASS: T2.4 B10 zero forbidden .py scripts in repository");
    } else { fail = fail + 1; println("FAIL: T2.4 B10 zero forbidden .py scripts in repository"); }

    // T2_B10.5: Academy header in all qa probes
    let r_acad: Result[String, String] = process_exec(sys, "bad=0; for f in $(find $OODA_TUI_ROOT/qa -name '*.oo'); do if ! head -7 \"$f\" | grep -q '// # '; then bad=$((bad+1)); fi; done; test $bad -eq 0");
    if r_acad.is_ok() {
        pass = pass + 1; println("PASS: T2.5 B10 all qa probes contain Academy headers");
    } else { fail = fail + 1; println("FAIL: T2.5 B10 all qa probes contain Academy headers"); }

    // B11: Typecheck & Flag Boundaries (5 tests)
    // T2_B11.1: Empty string preset name fails closed
    let r_emp_pre: Result[String, String] = process_exec(sys, bin + " --preset '' 2>/dev/null");
    if r_emp_pre.is_err() {
        pass = pass + 1; println("PASS: T2.6 B11 empty preset argument rejected fail-closed");
    } else { fail = fail + 1; println("FAIL: T2.6 B11 empty preset argument rejected fail-closed"); }

    // T2_B11.2: Multiple invalid flags fail closed with code 2
    let r_mult_bad: Result[String, String] = process_exec(sys, bin + " --bogus1 --bogus2 2>/dev/null");
    if r_mult_bad.is_err() {
        pass = pass + 1; println("PASS: T2.7 B11 multiple invalid flags rejected fail-closed");
    } else { fail = fail + 1; println("FAIL: T2.7 B11 multiple invalid flags rejected fail-closed"); }

    // T2_B11.3: Missing flag argument to --cwd fails closed
    let r_miss_cwd: Result[String, String] = process_exec(sys, bin + " --cwd 2>/dev/null");
    if r_miss_cwd.is_err() {
        pass = pass + 1; println("PASS: T2.8 B11 missing --cwd argument rejected fail-closed");
    } else { fail = fail + 1; println("FAIL: T2.8 B11 missing --cwd argument rejected fail-closed"); }

    // T2_B11.4: Deterministic exit code 2 on invalid flags
    let r_det1: Result[String, String] = process_exec(sys, bin + " --invalid-flag-repeat 2>/dev/null");
    let r_det2: Result[String, String] = process_exec(sys, bin + " --invalid-flag-repeat 2>/dev/null");
    if r_det1.is_err() && r_det2.is_err() {
        pass = pass + 1; println("PASS: T2.9 B11 repeated invalid flag execution deterministically fails closed");
    } else { fail = fail + 1; println("FAIL: T2.9 B11 repeated invalid flag execution deterministically fails closed"); }

    // T2_B11.5: Valid preset kernel launches and exits code 0
    let r_kern: Result[String, String] = process_exec(sys, "echo '/exit' | " + bin + " --preset kernel 2>&1");
    if r_kern.is_ok() {
        pass = pass + 1; println("PASS: T2.10 B11 valid preset kernel executes and exits cleanly");
    } else { fail = fail + 1; println("FAIL: T2.10 B11 valid preset kernel executes and exits cleanly"); }

    // B12: Binary Parity Boundaries (5 tests)
    // T2_B12.1: dist/ooda-tui size > 50KB
    let r_sz_dist: Result[String, String] = process_exec(sys, "test $(stat -c%s $OODA_TUI_ROOT/dist/ooda-tui) -gt 50000");
    if r_sz_dist.is_ok() {
        pass = pass + 1; println("PASS: T2.11 B12 dist binary exceeds 50KB threshold");
    } else { fail = fail + 1; println("FAIL: T2.11 B12 dist binary exceeds 50KB threshold"); }

    // T2_B12.2: $OODA_HOME/.openooda/bin/ooda-tui size > 50KB
    let r_sz_inst: Result[String, String] = process_exec(sys, "test $(stat -c%s $OODA_HOME/.openooda/bin/ooda-tui) -gt 50000");
    if r_sz_inst.is_ok() {
        pass = pass + 1; println("PASS: T2.12 B12 installed binary exceeds 50KB threshold");
    } else { fail = fail + 1; println("FAIL: T2.12 B12 installed binary exceeds 50KB threshold"); }

    // T2_B12.3: File size match between dist and install
    let r_sz_match: Result[String, String] = process_exec(sys, "test $(stat -c%s $OODA_TUI_ROOT/dist/ooda-tui) -eq $(stat -c%s $OODA_HOME/.openooda/bin/ooda-tui)");
    if r_sz_match.is_ok() {
        pass = pass + 1; println("PASS: T2.13 B12 byte count between dist and install matches exactly");
    } else { fail = fail + 1; println("FAIL: T2.13 B12 byte count between dist and install matches exactly"); }

    // T2_B12.4: Deterministic SHA-256 digest calculation
    let r_sha1: Result[String, String] = process_exec(sys, "sha256sum $OODA_TUI_ROOT/dist/ooda-tui | cut -d' ' -f1");
    let r_sha2: Result[String, String] = process_exec(sys, "sha256sum $OODA_TUI_ROOT/dist/ooda-tui | cut -d' ' -f1");
    if r_sha1.is_ok() && r_sha2.is_ok() && r_sha1.unwrap() == r_sha2.unwrap() {
        pass = pass + 1; println("PASS: T2.14 B12 consecutive SHA-256 calculations are deterministic");
    } else { fail = fail + 1; println("FAIL: T2.14 B12 consecutive SHA-256 calculations are deterministic"); }

    // T2_B12.5: Parity holds under plain environment
    let r_par_plain: Result[String, String] = process_exec(sys, "NO_COLOR=1 test $(sha256sum $OODA_TUI_ROOT/dist/ooda-tui | cut -d' ' -f1) = $(sha256sum $OODA_HOME/.openooda/bin/ooda-tui | cut -d' ' -f1)");
    if r_par_plain.is_ok() {
        pass = pass + 1; println("PASS: T2.15 B12 binary parity holds under plain environment");
    } else { fail = fail + 1; println("FAIL: T2.15 B12 binary parity holds under plain environment"); }

    println("qa/e2e_tier2_b10_b12: pass=" + int_to_str(pass) + " fail=" + int_to_str(fail));
    if fail > 0 { return Err("qa/e2e_tier2_b10_b12: failures detected"); }
    return Ok(0);
}

pub fn main(bind: &BindCap, fs_r: &FsReadCap, fs_w: &FsWriteCap, sys: &ProcessCap, sys_cap: &SysCap, env: &EnvCap, time: &TimeCap, alloc: &AllocCap, thread: &ThreadCap, args: List[String]) -> Result[Int, String] {
    println("qa/e2e_tier2_b10_b12: starting B10-B12 boundary probe");
    let bin: String = resolve_tui_bin(sys);
    println("qa/e2e_tier2_b10_b12: target binary=" + bin);

    // Double-run verification: Run_1 == Run_2
    let r1: Result[Int, String] = run_tier2_b10_b12(sys, bin);
    if r1.is_err() { return r1; }
    let r2: Result[Int, String] = run_tier2_b10_b12(sys, bin);
    if r2.is_err() { return r2; }

    println("qa/e2e_tier2_b10_b12: PASS (Double-Run verified)");
    return Ok(0);
}

fn int_to_str(n: Int) -> String {
    if n < 0 { return "0"; }
    if n == 0 { return "0"; }
    let digits: String = "0123456789";
    let mut v: Int = n;
    let mut rev: String = "";
    while v > 0 {
        let d: Int = v - (v / 10) * 10;
        rev = rev + char_at(digits, d);
        v = v / 10;
    }
    let mut out: String = "";
    let mut k: Int = chars_len(rev) - 1;
    while k >= 0 {
        out = out + char_at(rev, k);
        k = k - 1;
    }
    return out;
}
