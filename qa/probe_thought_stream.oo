// # qa/probe_thought_stream.oo - Thought Stream & Reasoning Card Probe
//
// Logline: Comprehensive hostile probe asserting thinking token extraction, card rendering, collapsed vs expanded states, and zero-ESC plain mode.
//
// Setup: Pure in-process probe importing ui/cards/card_thought.oo, theme.oo, and plugins/registry.oo.
//
// Beats:
//   1. Assert thinking token extraction (<think> tags, empty tags, unclosed tags, plain text, multiple blocks).
//   2. Assert post-think content preservation without text loss.
//   3. Assert card rendering with theme token thinkingText in color mode.
//   4. Assert collapsed (1-line summary) vs expanded (multi-line framed card) states.
//   5. Assert zero-ESC bytes in plain mode under color=false.
//   6. Assert height invariants for expanded, collapsed, and empty states.
//   7. Assert double-run byte-for-byte determinism (Run_1 == Run_2).

import "ui/cards/card_thought.oo";
import "theme.oo";
import "plugins/registry.oo";

pub fn qa_thought_stream_run() -> Int {
    let mut pass: Int = 0;
    let mut fail: Int = 0;

    // 1. Extraction: Well-formed <think> tags
    let raw1: String = "<think>analyzing architectural constraints</think>solution proposed";
    let th1: String = extract_think(raw1);
    let rest1: String = strip_think_preserve(raw1);
    if th1 == "analyzing architectural constraints" && rest1 == "solution proposed" {
        pass = pass + 1;
    } else {
        fail = fail + 1;
        println("FAIL: extraction of well-formed think block failed");
    }

    // 2. Extraction: Multi-line reasoning block
    let raw2: String = "<think>step 1: identify bottleneck\nstep 2: optimize allocation</think>ready to execute";
    let th2: String = extract_think(raw2);
    let rest2: String = strip_think_preserve(raw2);
    if str_contains(th2, "step 1:") && str_contains(th2, "step 2:") && rest2 == "ready to execute" {
        pass = pass + 1;
    } else {
        fail = fail + 1;
        println("FAIL: extraction of multi-line thinking block failed");
    }

    // 3. Extraction: Plain text without <think> tags (empty return, no data loss)
    let raw3: String = "direct response without thinking block";
    let th3: String = extract_think(raw3);
    let rest3: String = strip_think_preserve(raw3);
    if th3 == "" && rest3 == "direct response without thinking block" {
        pass = pass + 1;
    } else {
        fail = fail + 1;
        println("FAIL: plain text handling produced non-empty think or altered text");
    }

    // 4. Boundary: Empty <think></think> tags
    let raw4: String = "<think></think>immediate answer";
    let th4: String = extract_think(raw4);
    let rest4: String = strip_think_preserve(raw4);
    if th4 == "" && rest4 == "immediate answer" {
        pass = pass + 1;
    } else {
        fail = fail + 1;
        println("FAIL: empty think tags failed to return empty string");
    }

    // 5. Boundary: Unclosed <think> tag (fail-safe recovery)
    let raw5: String = "<think>unclosed reasoning content";
    let th5: String = extract_think(raw5);
    let rest5: String = strip_think_preserve(raw5);
    if th5 == "unclosed reasoning content" && rest5 == "" {
        pass = pass + 1;
    } else {
        fail = fail + 1;
        println("FAIL: unclosed think tag fail-safe extraction failed");
    }

    // 6. Boundary: Multiple <think> blocks
    let raw6: String = "<think>first thought</think>first part<think>second thought</think>second part";
    let th6: String = extract_think(raw6);
    let rest6: String = strip_think_preserve(raw6);
    if str_contains(th6, "first thought") && str_contains(th6, "second thought") && rest6 == "first partsecond part" {
        pass = pass + 1;
    } else {
        fail = fail + 1;
        println("FAIL: multiple think blocks extraction failed");
    }

    // 7. Card Plugin Descriptor
    let cp: CardPlugin = card_thought_plugin();
    if cp.name == "card_thought" && cp.enabled && cp.style == "collapsible" {
        pass = pass + 1;
    } else {
        fail = fail + 1;
        println("FAIL: card_thought_plugin metadata invalid");
    }

    // 8. Expanded Card Rendering in Color Mode
    let ren_exp: String = card_thought("1982", true, "memory layout audit", 80);
    if str_contains(ren_exp, ansi_esc()) && str_contains(ren_exp, "memory layout audit") && count_newlines(ren_exp) >= 2 {
        pass = pass + 1;
    } else {
        fail = fail + 1;
        println("FAIL: expanded thought card missing ANSI sequences, content, or framing");
    }

    // 9. Collapsed Card Rendering (Strict 1-Line Invariant)
    let ren_coll: String = card_thought_collapsed("1982", true, "memory layout audit", 80);
    if str_contains(ren_coll, ansi_esc()) && count_newlines(ren_coll) == 1 && (str_contains(ren_coll, "Thinking") || str_contains(ren_coll, "thought")) {
        pass = pass + 1;
    } else {
        fail = fail + 1;
        println("FAIL: collapsed thought card newline count != 1 or missing label");
    }

    // 10. Plain Mode Zero-ESC Byte Guarantee (Expanded)
    let plain_exp: String = card_thought("1982", false, "pure reasoning content", 80);
    if !str_contains(plain_exp, ansi_esc()) && str_contains(plain_exp, "pure reasoning content") {
        pass = pass + 1;
    } else {
        fail = fail + 1;
        println("FAIL: plain expanded card contains ESC bytes or lost content");
    }

    // 11. Plain Mode Zero-ESC Byte Guarantee (Collapsed)
    let plain_coll: String = card_thought_collapsed("1982", false, "pure reasoning content", 80);
    if !str_contains(plain_coll, ansi_esc()) && count_newlines(plain_coll) == 1 {
        pass = pass + 1;
    } else {
        fail = fail + 1;
        println("FAIL: plain collapsed card contains ESC bytes or newline != 1");
    }

    // 12. Strict Height Invariants
    let h_exp: Int = card_thought_height("memory layout audit", false, 80);
    let h_coll: Int = card_thought_height("memory layout audit", true, 80);
    let h_zero: Int = card_thought_height("", false, 80);
    if h_exp == count_newlines(ren_exp) && h_coll == count_newlines(ren_coll) && h_zero == 0 {
        pass = pass + 1;
    } else {
        fail = fail + 1;
        println("FAIL: height invariant mismatch");
    }

    // 13. Double-Run Byte-for-Byte Determinism (Run_1 == Run_2)
    let ren_exp2: String = card_thought("1982", true, "memory layout audit", 80);
    let ren_coll2: String = card_thought_collapsed("1982", true, "memory layout audit", 80);
    if ren_exp == ren_exp2 && ren_coll == ren_coll2 {
        pass = pass + 1;
    } else {
        fail = fail + 1;
        println("FAIL: double-run byte equality failed on thought cards");
    }

    println("qa/probe_thought_stream: pass=" + int_to_str(pass) + " fail=" + int_to_str(fail));
    if fail > 0 { return 1; }
    return 0;
}

pub fn main(bind: &BindCap, fs_r: &FsReadCap, fs_w: &FsWriteCap, sys: &ProcessCap, sys_cap: &SysCap, env: &EnvCap, time: &TimeCap, alloc: &AllocCap, thread: &ThreadCap, args: List[String]) -> Result[Int, String] {
    println("qa/probe_thought_stream: starting thought stream probe");
    let res: Int = qa_thought_stream_run();
    if res != 0 {
        return Err("qa/probe_thought_stream failed");
    }
    return Ok(0);
}

fn count_newlines(s: String) -> Int {
    let n: Int = chars_len(s);
    let mut count: Int = 0;
    let mut i: Int = 0;
    while i < n {
        if char_at(s, i) == "\n" { count = count + 1; }
        i = i + 1;
    }
    return count;
}

fn int_to_str(n: Int) -> String {
    if n <= 0 { return "0"; }
    let digits: String = "0123456789";
    let mut v: Int = n;
    let mut rev: String = "";
    while v > 0 {
        let d: Int = v - (v / 10) * 10;
        rev = rev + char_at(digits, d);
        v = v / 10;
    }
    let mut out: String = "";
    let mut k: Int = chars_len(rev) - 1;
    while k >= 0 {
        out = out + char_at(rev, k);
        k = k - 1;
    }
    return out;
}
