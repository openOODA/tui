// # qa/probe_input_header.oo - Header Input Box Probe
//
// Logline: Hostile test probe asserting 3-row layout, brand, mode chips, cursor placement, and zero-ESC plain mode.
//
// Setup: Pure in-process probe importing ui/input/input_header.oo and theme.oo.
//
// Beats:
//   1. Assert 3-row layout and height contract.
//   2. Assert brand "openOODA", mode chips, and keyboard hints.
//   3. Assert prompt row prefix "│ > " and suffix "│".
//   4. Assert CUP cursor sequence \x1b[2;5H in color and empty string in plain.
//   5. Assert zero ESC bytes under plain mode and double-run determinism.

import "ui/input/input_header.oo";
import "theme.oo";

pub fn qa_input_header_run() -> Int {
    let mut pass: Int = 0;
    let mut fail: Int = 0;

    // 1. Assert height contract
    if input_header_height() == 3 {
        pass = pass + 1;
    } else {
        fail = fail + 1;
        println("FAIL: input_header_height != 3");
    }

    // 2. Render standard 80-col color frame
    let frame_80: String = input_header_render("1982", "", "build", "ask", true, 80);
    let n_lines: Int = count_newlines(frame_80);
    if n_lines == 3 {
        pass = pass + 1;
    } else {
        fail = fail + 1;
        println("FAIL: frame_80 line count != 3, got: " + int_to_str(n_lines));
    }

    // 3. Assert surface markers on Row 1, Row 2, Row 3
    if str_contains(frame_80, "openOODA") && str_contains(frame_80, "[build]") && str_contains(frame_80, "[plan]") && str_contains(frame_80, "[ask]") {
        pass = pass + 1;
    } else {
        fail = fail + 1;
        println("FAIL: frame_80 missing brand or mode chips");
    }

    if str_contains(frame_80, "Enter sends · /help") && str_contains(frame_80, "╭─") && str_contains(frame_80, "─╮") {
        pass = pass + 1;
    } else {
        fail = fail + 1;
        println("FAIL: frame_80 missing top border corners or hint");
    }

    if str_contains(frame_80, "│") && str_contains(frame_80, "> ") && str_contains(frame_80, "╰") && str_contains(frame_80, "╯") {
        pass = pass + 1;
    } else {
        fail = fail + 1;
        println("FAIL: frame_80 missing prompt row or bottom border");
    }

    // 4. Assert cursor position sequence
    let cur_col: String = input_header_cursor(true);
    let cur_plain: String = input_header_cursor(false);
    let expected_cur: String = ansi_esc() + "[2;5H";
    if cur_col == expected_cur && cur_plain == "" && chars_len(cur_col) == 6 {
        pass = pass + 1;
    } else {
        fail = fail + 1;
        println("FAIL: input_header_cursor sequence incorrect");
    }

    // 5. Assert plain mode: zero ESC bytes and proper markers
    let frame_plain: String = input_header_render("1982", "echo test", "build", "ask", false, 80);
    if !str_contains(frame_plain, ansi_esc()) && str_contains(frame_plain, "openOODA") && str_contains(frame_plain, "│ > echo test") {
        pass = pass + 1;
    } else {
        fail = fail + 1;
        println("FAIL: frame_plain contains ESC bytes or missing echo");
    }

    // 6. Assert ask mode switching
    let frame_ask: String = input_header_render("1982", "ask", "ask", "ask", true, 80);
    if str_contains(frame_ask, "y yes · n no · a always · d deny") {
        pass = pass + 1;
    } else {
        fail = fail + 1;
        println("FAIL: frame_ask missing permission confirmation hint");
    }

    // 7. Assert boundary clamping on small cols
    let frame_sm: String = input_header_render("1982", "", "build", "ask", false, 20);
    if count_newlines(frame_sm) == 3 && str_contains(frame_sm, "openOODA") {
        pass = pass + 1;
    } else {
        fail = fail + 1;
        println("FAIL: frame_sm boundary clamping failed");
    }

    // 8. Assert double-run byte-for-byte determinism
    let frame_80_run2: String = input_header_render("1982", "", "build", "ask", true, 80);
    if frame_80 == frame_80_run2 {
        pass = pass + 1;
    } else {
        fail = fail + 1;
        println("FAIL: double-run not byte-equal");
    }

    println("qa/probe_input_header: pass=" + int_to_str(pass) + " fail=" + int_to_str(fail));
    if fail > 0 { return 1; }
    return 0;
}

pub fn main(bind: &BindCap, fs_r: &FsReadCap, fs_w: &FsWriteCap, sys: &ProcessCap, sys_cap: &SysCap, env: &EnvCap, time: &TimeCap, alloc: &AllocCap, thread: &ThreadCap, args: List[String]) -> Result[Int, String] {
    println("qa/probe_input_header: starting probe");
    let res: Int = qa_input_header_run();
    if res != 0 {
        return Err("qa/probe_input_header failed");
    }
    return Ok(0);
}

fn count_newlines(s: String) -> Int {
    let n: Int = chars_len(s);
    let mut count: Int = 0;
    let mut i: Int = 0;
    while i < n {
        if char_at(s, i) == "\n" { count = count + 1; }
        i = i + 1;
    }
    return count;
}

fn int_to_str(n: Int) -> String {
    if n <= 0 { return "0"; }
    let digits: String = "0123456789";
    let mut v: Int = n;
    let mut rev: String = "";
    while v > 0 {
        let d: Int = v - (v / 10) * 10;
        rev = rev + char_at(digits, d);
        v = v / 10;
    }
    let mut out: String = "";
    let mut k: Int = chars_len(rev) - 1;
    while k >= 0 {
        out = out + char_at(rev, k);
        k = k - 1;
    }
    return out;
}
