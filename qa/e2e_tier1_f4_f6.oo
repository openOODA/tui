// # qa/e2e_tier1_f4_f6 - E2E Tier 1 Features 4-6 Probe
//
// Logline: Comprehensive opaque-box verification of Footer Statusbar, Telemetry, and Intermediate Canvas.
//
// Setup: Executes compiled ooda-tui release binaries under &ProcessCap and verifies status and canvas output.
//
// Beats:
//   1. F4 (Environmental Footer): Renders provider, model, CWD, and operational status.
//   2. F5 (Tool & Service Telemetry): Displays MCP, LSP, teamwork, and version telemetry.
//   3. F6 (Intermediate Canvas): Accommodates conversational canvas, welcome dashboard, and scrollback.

import "std/fs/process/process.oo";

pub fn resolve_tui_bin(sys: &ProcessCap) -> String {
    let r_inst: Result[String, String] = process_exec(sys, "test -x ~/.openooda/bin/ooda-tui");
    if r_inst.is_ok() { return "~/.openooda/bin/ooda-tui"; }
    let r_dist: Result[String, String] = process_exec(sys, "test -x ./dist/ooda-tui");
    if r_dist.is_ok() { return "./dist/ooda-tui"; }
    return "./dist/ooda-tui";
}

pub fn run_tier1_f4_f6(sys: &ProcessCap, bin: String) -> Result[Int, String] {
    let mut pass: Int = 0;
    let mut fail: Int = 0;

    let r_base: Result[String, String] = process_exec(sys, "printf '/exit\\n' | " + bin + " 2>&1");
    let out: String = match r_base { Ok(s) => s, Err(_) => "" };

    // F4: Environmental Footer Statusbar (5 tests)
    // T4.1: Statusbar rendered on frame
    if str_contains(out, "╰─") || str_contains(out, "+-") {
        pass = pass + 1; println("PASS: T4.1 F4 statusbar frame boundary rendered");
    } else { fail = fail + 1; println("FAIL: T4.1 F4 statusbar frame boundary rendered"); }

    // T4.2: Provider displayed in output
    if str_contains(out, "minimax") || str_contains(out, "muse") {
        pass = pass + 1; println("PASS: T4.2 F4 active provider displayed");
    } else { fail = fail + 1; println("FAIL: T4.2 F4 active provider displayed"); }

    // T4.3: Model displayed in output
    if str_contains(out, "MiniMax") || str_contains(out, "spark") || str_contains(out, "model") {
        pass = pass + 1; println("PASS: T4.3 F4 active model displayed");
    } else { fail = fail + 1; println("FAIL: T4.3 F4 active model displayed"); }

    // T4.4: Current working directory displayed
    if str_contains(out, "CWD:") || str_contains(out, "openOODA") {
        pass = pass + 1; println("PASS: T4.4 F4 current working directory displayed");
    } else { fail = fail + 1; println("FAIL: T4.4 F4 current working directory displayed"); }

    // T4.5: Operational mode badge displayed
    if str_contains(out, "Mode:") || str_contains(out, "ASK") || str_contains(out, "build") {
        pass = pass + 1; println("PASS: T4.5 F4 operational mode badge displayed");
    } else { fail = fail + 1; println("FAIL: T4.5 F4 operational mode badge displayed"); }

    // F5: Tool & Service Telemetry (5 tests)
    // T5.1: MCP telemetry displayed
    if str_contains(out, "MCP:") || str_contains(out, "mcp") {
        pass = pass + 1; println("PASS: T5.1 F5 MCP telemetry displayed");
    } else { fail = fail + 1; println("FAIL: T5.1 F5 MCP telemetry displayed"); }

    // T5.2: Sandboxed tools catalog displayed
    if str_contains(out, "tools") && str_contains(out, "read") && str_contains(out, "grep") {
        pass = pass + 1; println("PASS: T5.2 F5 sandboxed tools catalog displayed");
    } else { fail = fail + 1; println("FAIL: T5.2 F5 sandboxed tools catalog displayed"); }

    // T5.3: Teamwork flag execution support
    let r_team: Result[String, String] = process_exec(sys, "printf '/exit\\n' | " + bin + " --teamwork 2>&1");
    if r_team.is_ok() {
        pass = pass + 1; println("PASS: T5.3 F5 teamwork operational flag supported");
    } else { fail = fail + 1; println("FAIL: T5.3 F5 teamwork operational flag supported"); }

    // T5.4: Version string displayed
    if str_contains(out, "v0.3.") || str_contains(out, "ooda-tui") {
        pass = pass + 1; println("PASS: T5.4 F5 version telemetry displayed");
    } else { fail = fail + 1; println("FAIL: T5.4 F5 version telemetry displayed"); }

    // T5.5: Quick start guidance displayed
    if str_contains(out, "Quick Start:") || str_contains(out, "/help") {
        pass = pass + 1; println("PASS: T5.5 F5 quick start telemetry guidance displayed");
    } else { fail = fail + 1; println("FAIL: T5.5 F5 quick start telemetry guidance displayed"); }

    // F6: Intermediate Canvas Area (5 tests)
    // T6.1: Welcome canvas rendered in intermediate area
    if str_contains(out, "openOODA TUI") {
        pass = pass + 1; println("PASS: T6.1 F6 intermediate welcome canvas rendered");
    } else { fail = fail + 1; println("FAIL: T6.1 F6 intermediate welcome canvas rendered"); }

    // T6.2: Canvas accommodates slash command reference
    if str_contains(out, "/preset") && str_contains(out, "/tools") {
        pass = pass + 1; println("PASS: T6.2 F6 intermediate canvas houses command cards");
    } else { fail = fail + 1; println("FAIL: T6.2 F6 intermediate canvas houses command cards"); }

    // T6.3: Canvas vertical height separation exists
    if chars_len(out) > 500 {
        pass = pass + 1; println("PASS: T6.3 F6 canvas vertical span accommodates content");
    } else { fail = fail + 1; println("FAIL: T6.3 F6 canvas vertical span accommodates content"); }

    // T6.4: Preset audit sets specialized canvas
    let r_audit: Result[String, String] = process_exec(sys, "printf '/exit\\n' | " + bin + " --preset audit 2>&1");
    if r_audit.is_ok() && chars_len(r_audit.unwrap()) > 200 {
        pass = pass + 1; println("PASS: T6.4 F6 audit preset configures intermediate canvas");
    } else { fail = fail + 1; println("FAIL: T6.4 F6 audit preset configures intermediate canvas"); }

    // T6.5: Clean exit without canvas residue
    let r_clean: Result[String, String] = process_exec(sys, "printf '/exit\\n' | " + bin + " --no-color 2>&1");
    if r_clean.is_ok() {
        pass = pass + 1; println("PASS: T6.5 F6 intermediate canvas exits cleanly");
    } else { fail = fail + 1; println("FAIL: T6.5 F6 intermediate canvas exits cleanly"); }

    println("qa/e2e_tier1_f4_f6: pass=" + int_to_str(pass) + " fail=" + int_to_str(fail));
    if fail > 0 { return Err("qa/e2e_tier1_f4_f6: failures detected"); }
    return Ok(0);
}

pub fn main(bind: &BindCap, fs_r: &FsReadCap, fs_w: &FsWriteCap, sys: &ProcessCap, sys_cap: &SysCap, env: &EnvCap, time: &TimeCap, alloc: &AllocCap, thread: &ThreadCap, args: List[String]) -> Result[Int, String] {
    println("qa/e2e_tier1_f4_f6: starting F4-F6 coverage probe");
    let bin: String = resolve_tui_bin(sys);
    println("qa/e2e_tier1_f4_f6: target binary=" + bin);

    // Double-run verification: Run_1 == Run_2
    let r1: Result[Int, String] = run_tier1_f4_f6(sys, bin);
    if r1.is_err() { return r1; }
    let r2: Result[Int, String] = run_tier1_f4_f6(sys, bin);
    if r2.is_err() { return r2; }

    println("qa/e2e_tier1_f4_f6: PASS (Double-Run verified)");
    return Ok(0);
}

fn int_to_str(n: Int) -> String {
    if n < 0 { return "0"; }
    if n == 0 { return "0"; }
    let digits: String = "0123456789";
    let mut v: Int = n;
    let mut rev: String = "";
    while v > 0 {
        let d: Int = v - (v / 10) * 10;
        rev = rev + char_at(digits, d);
        v = v / 10;
    }
    let mut out: String = "";
    let mut k: Int = chars_len(rev) - 1;
    while k >= 0 {
        out = out + char_at(rev, k);
        k = k - 1;
    }
    return out;
}
