// # Test TUI — Run Master E2E and QA Checks
//
// Logline: Run the master E2E test suite under OODA_COMPILER and verify all 138 tests pass.
//
// Setup: Double-run identity law for TUI E2E test suite. Resolves compiler via environment contract.
//
// Beats:
//   1. Resolve primary compiler binary.
//   2. Compile and execute e2e_master.oo twice.
//   3. Clean up temporary binaries and report status.

import "std/fs/process/env.oo";

fn run_master_once(p: &ProcessCap, oodac: String, home: String, root: String) -> Result[Int, String] {
    let path: String = "qa/e2e/e2e_master.oo";
    let tmp_bin: String = "qa/e2e/e2e_master.tmp.bin";
    let b: Result[String, String] = sys_exec(p, oodac, "build", path, "-o", tmp_bin);
    if b.is_err() {
        let e: String = match b { Ok(_) => "", Err(m) => m };
        return Err("compile fail " + path + ": " + e);
    }
    let r: Result[String, String] = sys_exec(p, "env", "OODA_COMPILER=" + oodac, "OODA_HOME=" + home, "OODA_TUI_ROOT=" + root, tmp_bin);
    let _del: Result[String, String] = sys_exec(p, "rm", "-f", tmp_bin);
    if r.is_err() {
        let e: String = match r { Ok(_) => "", Err(m) => m };
        return Err("exec fail " + path + ": " + e);
    }
    return Ok(0);
}

pub fn main(p: &ProcessCap, fs_r: &FsReadCap, env: &EnvCap, args: List[String]) -> Result[Int, String] {
    let hr: Result[String, String] = env_get(env, "HOME");
    let mut home: String = match hr { Ok(s) => s, Err(_) => "" };
    if home == "" {
        let ohr: Result[String, String] = env_get(env, "OODA_HOME");
        home = match ohr { Ok(s) => s, Err(_) => "" };
    }
    if home == "" { home = "/home/ubermetroid"; }

    let rr: Result[String, String] = env_get(env, "OODA_TUI_ROOT");
    let mut root: String = match rr { Ok(s) => s, Err(_) => "" };
    if root == "" { root = "/home/ubermetroid/Projects/openOODA/tui"; }

    let cr: Result[String, String] = env_get(env, "OODA_COMPILER");
    let mut oodac: String = match cr { Ok(s) => s, Err(_) => "" };
    if oodac == "" {
        let tr: Result[String, String] = env_get(env, "OODA_TOOLCHAIN");
        let th: String = match tr { Ok(s) => s, Err(_) => "" };
        if th != "" { oodac = th + "/bin/oodac"; }
    }
    if oodac == "" {
        if home != "" { oodac = home + "/.openooda/bin/oodac"; }
    }
    if oodac == "" || !path_exists(fs_r, oodac) {
        return Err("no compiler (OODA_COMPILER, OODA_TOOLCHAIN, or HOME layout)");
    }

    println("tui suite: running e2e_master");
    let r1: Result[Int, String] = run_master_once(p, oodac, home, root);
    if r1.is_err() { return r1; }
    let r2: Result[Int, String] = run_master_once(p, oodac, home, root);
    if r2.is_err() { return r2; }

    println("tui test suite: ALL PROBES PASSED (double-run identical)");
    return Ok(0);
}
