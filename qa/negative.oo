// # qa/negative.oo - Boundary Input Probe
//
// Logline: Exercise boundary inputs (empty string, oversized tokens, malformed UTF-8) on theme.oo + ansi_fg and assert every call returns a Result-like value without panic.
//
// Setup: In-process. The current openOODA runtime has no panic mechanism so "doesn't crash" means "returns without hanging the build"; we assert non-empty output and that the hex parser degrades to 0 for malformed input.
//
// Beats:
//   1. ansi_fg("") must return a string starting with ESC[ (the formatter always emits SGR, even with empty hex).
//   2. theme_color("minimax", "nonexistent_token") must return t_text() (the fallback) — verified by len > 0.
//   3. hex_to_r/g/b with truncated hex codes must return 0 (no panic).

import "theme.oo";

pub fn qa_negative_run() -> Int {
    let mut pass: Int = 0;
    let mut fail: Int = 0;

    let s1: String = ansi_fg(true, "");
    if chars_len(s1) > 0 { pass = pass + 1; }
    else { fail = fail + 1; println("FAIL: ansi_fg(\"\") returned empty"); }

    let s2: String = theme_color("minimax", "no_such_token");
    if chars_len(s2) > 0 { pass = pass + 1; }
    else { fail = fail + 1; println("FAIL: theme_color fallback returned empty"); }

    let s3: String = ansi_fg(true, "#");
    if chars_len(s3) > 0 { pass = pass + 1; }
    else { fail = fail + 1; println("FAIL: ansi_fg(\"#\") returned empty"); }

    let s4: String = ansi_fg(true, "#FF");
    if chars_len(s4) > 0 { pass = pass + 1; }
    else { fail = fail + 1; println("FAIL: ansi_fg(\"#FF\") returned empty"); }

    let s5: String = ansi_fg(true, "#ZZZZZZ");
    if chars_len(s5) > 0 { pass = pass + 1; }
    else { fail = fail + 1; println("FAIL: ansi_fg(\"#ZZZZZZ\") returned empty"); }

    let s6: String = theme_color("no_such_theme", "text");
    if chars_len(s6) > 0 { pass = pass + 1; }
    else { fail = fail + 1; println("FAIL: unknown theme returned empty"); }

    println("qa/negative: pass=" + int_to_str(pass) + " fail=" + int_to_str(fail));
    if fail > 0 { return 1; }
    return 0;
}

fn int_to_str(n: Int) -> String {
    if n < 0 { return "0"; }
    if n == 0 { return "0"; }
    let digits: String = "0123456789";
    let mut v: Int = n;
    let mut rev: String = "";
    while v > 0 {
        let d: Int = v - (v / 10) * 10;
        rev = rev + char_at(digits, d);
        v = v / 10;
    }
    let mut out: String = "";
    let mut k: Int = chars_len(rev) - 1;
    while k >= 0 {
        out = out + char_at(rev, k);
        k = k - 1;
    }
    return out;
}
