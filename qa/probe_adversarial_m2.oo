// # qa/probe_adversarial_m2.oo - Milestone 2 Adversarial Probe
//
// Logline: Hostile empirical stress tests for statusbar footer geometry, responsive budgeting, and determinism.
//
// Setup: In-process probe importing ui/statusbar/statusbar_footer.oo and theme.oo.
//
// Beats:
//   1. Stress test extreme column widths (40, 60, 75, 80, 120, 200) for exact visible width matching cols.
//   2. Stress test pathologically deep CWD paths and oversized provider/model strings.
//   3. Assert border integrity (╰─ and ─╯) and zero line-wrapping under hostile inputs.
//   4. Assert double-run byte-for-byte determinism (Run_1 == Run_2).
//   5. Return exit code and report verification metrics.

import "ui/statusbar/statusbar_footer.oo";
import "theme.oo";

fn count_nl(s: String) -> Int {
    let n: Int = chars_len(s);
    let mut c: Int = 0;
    let mut i: Int = 0;
    while i < n {
        if char_at(s, i) == "\n" { c = c + 1; }
        i = i + 1;
    }
    return c;
}

fn is_ansi_final(c: String) -> Bool {
    let finals: String = "mHJKABCDsf";
    let n: Int = chars_len(finals);
    let mut i: Int = 0;
    while i < n {
        if char_at(finals, i) == c { return true; }
        i = i + 1;
    }
    return false;
}

fn strip_ansi(s: String) -> String {
    let esc: String = ansi_esc();
    let n: Int = chars_len(s);
    let mut out: String = "";
    let mut i: Int = 0;
    while i < n {
        if char_at(s, i) == esc {
            i = i + 1;
            if i < n && char_at(s, i) == "[" {
                i = i + 1;
                while i < n {
                    let ch: String = char_at(s, i);
                    if is_ansi_final(ch) {
                        i = i + 1;
                        break;
                    }
                    i = i + 1;
                }
            }
        } else {
            out = out + char_at(s, i);
            i = i + 1;
        }
    }
    return out;
}

fn check_geometry(w: Int, color: Bool, prov: String, modl: String, cwd: String, mode: String, perm: String, think: String, team: Bool, mcp: Bool, lsp: Bool, ver: String) -> Bool {
    let rendered: String = statusbar_footer_render("minimax", prov, modl, cwd, mode, perm, think, team, mcp, lsp, ver, color, w);
    let nls: Int = count_nl(rendered);
    if nls != 1 {
        println("FAIL: cols=" + int_to_str(w) + " color=" + (if color { "T" } else { "F" }) + " newline count=" + int_to_str(nls));
        return false;
    }
    let stripped: String = strip_ansi(rendered);
    let vis_len: Int = chars_len(stripped);
    // rendered must end with newline, so vis_len should be w + 1 (line + newline)
    let vis_line_len: Int = vis_len - 1;
    if vis_line_len != w {
        println("FAIL: cols=" + int_to_str(w) + " expected_vis=" + int_to_str(w) + " actual_vis=" + int_to_str(vis_line_len) + " color=" + (if color { "T" } else { "F" }));
        println("  verbatim stripped: [" + str_slice(stripped, 0, vis_len - 1) + "]");
        return false;
    }
    if !str_contains(stripped, "╰─") || !str_contains(stripped, "─╯") {
        println("FAIL: cols=" + int_to_str(w) + " missing borders ╰─ or ─╯");
        return false;
    }
    return true;
}

pub fn qa_adversarial_m2_run() -> Int {
    let mut pass: Int = 0;
    let mut fail: Int = 0;

    let std_cwd: String = "/home/jeryd/Projects/openOODA/tui";
    let deep_cwd: String = "/home/jeryd/Projects/openOODA/submodules/deep/nested/path/to/an/extremely/long/directory/that/exceeds/all/reasonable/terminal/widths/and/should/be/truncated/cleanly/without/overflow";
    let long_prov: String = "very_long_custom_provider_name_that_never_ends";
    let long_modl: String = "very_long_specialized_distilled_reasoning_model_v999_large_instruct";

    // SECTION 1: Standard inputs across extreme column dimensions
    let widths: List[Int] = list_new();
    let widths: List[Int] = list_push(widths, 40);
    let widths: List[Int] = list_push(widths, 60);
    let widths: List[Int] = list_push(widths, 75);
    let widths: List[Int] = list_push(widths, 80);
    let widths: List[Int] = list_push(widths, 120);
    let widths: List[Int] = list_push(widths, 200);

    let mut wi: Int = 0;
    while wi < list_len(widths) {
        let w: Int = list_get(widths, wi);
        // Test color=true
        if check_geometry(w, true, "minimax", "MiniMax-M2.5", std_cwd, "build", "ask", "off", true, true, true, "v0.3.2") {
            pass = pass + 1;
        } else {
            fail = fail + 1;
        }
        // Test color=false
        if check_geometry(w, false, "minimax", "MiniMax-M2.5", std_cwd, "build", "ask", "off", true, true, true, "v0.3.2") {
            pass = pass + 1;
        } else {
            fail = fail + 1;
        }
        wi = wi + 1;
    }

    // SECTION 2: Pathologically deep CWD paths & oversized provider/model
    wi = 0;
    while wi < list_len(widths) {
        let w: Int = list_get(widths, wi);
        // Deep CWD
        if check_geometry(w, true, "minimax", "MiniMax-M2.5", deep_cwd, "build", "ask", "off", true, true, true, "v0.3.2") {
            pass = pass + 1;
        } else {
            fail = fail + 1;
        }
        // Long provider and model
        if check_geometry(w, true, long_prov, long_modl, std_cwd, "build", "ask", "off", true, true, true, "v0.3.2") {
            pass = pass + 1;
        } else {
            fail = fail + 1;
        }
        // Both deep CWD and long provider/model
        if check_geometry(w, false, long_prov, long_modl, deep_cwd, "plan", "yolo", "high", false, false, false, "v1.0.0-rc1") {
            pass = pass + 1;
        } else {
            fail = fail + 1;
        }
        wi = wi + 1;
    }

    // SECTION 3: Double-Run Byte-for-byte Determinism across multiple widths
    wi = 0;
    while wi < list_len(widths) {
        let w: Int = list_get(widths, wi);
        let r1: String = statusbar_footer_render("minimax", "minimax", "MiniMax-M2.5", deep_cwd, "build", "ask", "off", true, true, true, "v0.3.2", true, w);
        let r2: String = statusbar_footer_render("minimax", "minimax", "MiniMax-M2.5", deep_cwd, "build", "ask", "off", true, true, true, "v0.3.2", true, w);
        if r1 == r2 {
            pass = pass + 1;
        } else {
            fail = fail + 1;
            println("FAIL: double-run non-deterministic for w=" + int_to_str(w));
        }
        wi = wi + 1;
    }

    println("qa/probe_adversarial_m2: pass=" + int_to_str(pass) + " fail=" + int_to_str(fail));
    if fail > 0 { return 1; }
    return 0;
}

pub fn main(bind: &BindCap, fs_r: &FsReadCap, fs_w: &FsWriteCap, sys: &ProcessCap, sys_cap: &SysCap, env: &EnvCap, time: &TimeCap, alloc: &AllocCap, thread: &ThreadCap, args: List[String]) -> Result[Int, String] {
    println("qa/probe_adversarial_m2: starting hostile probe");
    let res: Int = qa_adversarial_m2_run();
    if res != 0 {
        return Err("qa/probe_adversarial_m2 failed");
    }
    return Ok(0);
}

fn int_to_str(n: Int) -> String {
    if n <= 0 { return "0"; }
    let digits: String = "0123456789";
    let mut v: Int = n;
    let mut rev: String = "";
    while v > 0 {
        let d: Int = v - (v / 10) * 10;
        rev = rev + char_at(digits, d);
        v = v / 10;
    }
    let mut out: String = "";
    let mut k: Int = chars_len(rev) - 1;
    while k >= 0 {
        out = out + char_at(rev, k);
        k = k - 1;
    }
    return out;
}
