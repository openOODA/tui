// # qa/e2e_master - Master E2E 4-Tier Test Runner (spawner)
//
// Logline: Build+run every qa/e2e_tier*.oo fresh; verify counts; prove 138.
// Setup: Zero-config oodac (OODA_COMPILER, OODA_TOOLCHAIN, HOME). Spawner, not
//        imports: oodac entry picks an imported main over the target's, so an
//        importing master silently ran tier1 only (found 2026-09-28).
// Beats:
//   1. Resolve primary compiler binary (OODA_COMPILER, OODA_TOOLCHAIN, HOME).
//   2. Enumerate qa/e2e_tier*.oo from the filesystem; fail closed unless exactly 10.
//   3. Build and run each tier fresh; fail closed on nonzero exit.
//   4. Verify each tier's "pass=N fail=0" stdout line against its registered N.
//   5. Sum the ten proven counts; fail closed unless the total is exactly 138.

import "std/fs/process/env.oo";
import "std/fs/file/path.oo";
import "std/fs/file/glob.oo";
import "std/core/text/natural_sort.oo";

fn resolve_oodac(env: &EnvCap, fs: &FsReadCap) -> Result[String, String] {
    let cr: Result[String, String] = env_get(env, "OODA_COMPILER");
    let mut oodac: String = match cr { Ok(s) => s, Err(_) => "" };
    if oodac == "" {
        let tr: Result[String, String] = env_get(env, "OODA_TOOLCHAIN");
        let th: String = match tr { Ok(s) => s, Err(_) => "" };
        if th != "" { oodac = th + "/bin/oodac"; }
    }
    if oodac == "" {
        let hr: Result[String, String] = env_get(env, "HOME");
        let home: String = match hr { Ok(s) => s, Err(_) => "" };
        if home != "" { oodac = home + "/.openooda/bin/oodac"; }
    }
    if oodac == "" || !path_exists(fs, oodac) {
        return Err("no compiler (OODA_COMPILER, OODA_TOOLCHAIN, or HOME layout)");
    }
    return Ok(oodac);
}

fn expected_for(path: String) -> Result[Int, String] {
    if str_contains(path, "tier3_") { return Ok(12); }
    if str_contains(path, "tier4_") { return Ok(6); }
    if str_contains(path, "tier1_") { return Ok(15); }
    if str_contains(path, "tier2_") { return Ok(15); }
    return Err("unregistered tier file (add its expected count): " + path);
}

fn run_tier(p: &ProcessCap, oodac: String, path: String, want: Int) -> Result[Int, String] {
    let tmp_bin: String = path + ".master.bin";
    let b: Result[String, String] = sys_exec(p, oodac, "build", path, "-o", tmp_bin);
    if b.is_err() {
        let e: String = match b { Ok(_) => "", Err(m) => m };
        return Err("compile fail " + path + ": " + e);
    }
    let r: Result[String, String] = sys_exec(p, tmp_bin);
    let _del: Result[String, String] = sys_exec(p, "rm", "-f", tmp_bin);
    if r.is_err() {
        let eo: String = match r { Ok(_) => "", Err(m) => m };
        println("--- captured output of " + path + " ---");
        println(eo);
        println("--- end output ---");
        return Err("tier failed (nonzero exit) " + path);
    }
    let out: String = match r { Ok(s) => s, Err(_) => "" };
    let needle: String = "pass=" + want.to_string() + " fail=0";
    if !str_contains(out, needle) {
        return Err("tier count line missing in " + path + " (want \"" + needle + "\")");
    }
    return Ok(want);
}

pub fn main(p: &ProcessCap, fs_r: &FsReadCap, env: &EnvCap, args: List[String]) -> Result[Int, String] {
    let cr: Result[String, String] = resolve_oodac(env, fs_r);
    if cr.is_err() { return Err(match cr { Ok(_) => "", Err(m) => m }); }
    let oodac: String = match cr { Ok(s) => s, Err(_) => "" };

    let found: List[String] = glob_scan_dir(fs_r, "qa", "e2e_tier*.oo");
    let files: List[String] = natural_sort_list(found);
    if list_len(files) != 10 {
        return Err("tier file count drift: found " + list_len(files).to_string() + ", want exactly 10 under qa/");
    }
    println("e2e_master: enumerated " + list_len(files).to_string() + " tier files");

    let mut total: Int = 0;
    let mut i: Int = 0;
    while i < list_len(files) {
        let path: String = list_get(files, i);
        println("  Running " + path);
        let er: Result[Int, String] = expected_for(path);
        if er.is_err() { return Err(match er { Ok(_) => "", Err(m) => m }); }
        let want: Int = match er { Ok(n) => n, Err(_) => 0 - 1 };
        let tr: Result[Int, String] = run_tier(p, oodac, path, want);
        if tr.is_err() {
            let m: String = match tr { Ok(_) => "", Err(e) => e };
            println("e2e_master FAIL: " + m);
            return tr;
        }
        let got: Int = match tr { Ok(n) => n, Err(_) => 0 - 1 };
        println("  Verified " + path + ": " + got.to_string() + " tests");
        total = total + got;
        i = i + 1;
    }

    if total != 138 {
        return Err("E2E total drift: proven " + total.to_string() + ", want 138");
    }
    println("e2e_master: 138/138 E2E tests proven across 10 tiers (each self-double-run)");
    return Ok(total);
}
