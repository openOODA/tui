// # loop.oo - LLM <-> MCP Tool-Call Loop
//
// Logline: The main conversational loop. Streams the user prompt to the LLM with the MCP tool list, parses tool_use blocks, calls the MCP tools, and continues.
//
// Setup: Imports llm.oo, mcp_client.oo, compact.oo. Single-turn per call for v0.1; the loop continues while the LLM emits tool_use.
//
// Beats:
//   1. Append the user message to the transcript.
//   2. Trigger compact.oo if context exceeds threshold.
//   3. Build the request: system + plan + goal + transcript + tool list.
//   4. Call the active LLM provider via llm.complete.
//   5. Parse the response: if tool_use present, call mcp.call_tool and loop; if final text, return.

import "llm.oo";
import "mcp_client.oo";

type LoopTurn = struct {
    role: String,
    content: String,
    kind: String,
    ts: Int
};

type LoopState = struct {
    turns: List[LoopTurn],
    plan: String,
    goal: String,
    tools_json: String
};

pub fn loop_state_new() -> LoopState {
    return LoopState { turns: list_new(), plan: "", goal: "", tools_json: "" };
}

pub fn loop_set_tools(state: LoopState, tools_json: String) -> LoopState {
    state.tools_json = tools_json;
    return state;
}

pub fn loop_set_plan(state: LoopState, plan: String) -> LoopState {
    state.plan = plan;
    return state;
}

pub fn loop_set_goal(state: LoopState, goal: String) -> LoopState {
    state.goal = goal;
    return state;
}

pub fn loop_turn_count(state: LoopState) -> Int {
    return list_len(state.turns);
}

pub fn loop_turn_at(state: LoopState, idx: Int) -> LoopTurn {
    return list_get(state.turns, idx);
}

pub fn loop_append_user(state: LoopState, content: String) -> LoopState {
    let t: LoopTurn = LoopTurn { role: "user", content: content, kind: "main", ts: now_seconds() };
    state.turns = list_push(state.turns, t);
    return state;
}

pub fn loop_append_side(state: LoopState, content: String) -> LoopState {
    let t: LoopTurn = LoopTurn { role: "user", content: content, kind: "side", ts: now_seconds() };
    state.turns = list_push(state.turns, t);
    return state;
}

pub fn loop_append_assistant(state: LoopState, content: String) -> LoopState {
    let t: LoopTurn = LoopTurn { role: "assistant", content: content, kind: "main", ts: now_seconds() };
    state.turns = list_push(state.turns, t);
    return state;
}

pub fn loop_append_tool(state: LoopState, name: String, args: String, result: String) -> LoopState {
    let t: LoopTurn = LoopTurn { role: "tool", content: name + ":" + args + " -> " + result, kind: "main", ts: now_seconds() };
    state.turns = list_push(state.turns, t);
    return state;
}

fn now_seconds() -> Int {
    return time_now();
}

pub fn loop_build_prompt(state: LoopState) -> String {
    let mut out: String = "";
    if state.goal != "" { out = out + "GOAL: " + state.goal + "\n"; }
    if state.plan != "" { out = out + "PLAN: " + state.plan + "\n"; }
    if state.tools_json != "" { out = out + "TOOLS: " + state.tools_json + "\n"; }
    let n: Int = list_len(state.turns);
    let mut i: Int = 0;
    while i < n {
        let t: LoopTurn = list_get(state.turns, i);
        let prefix: String = if t.kind == "side" { "[side] " } else { "" };
        out = out + "[" + t.role + "] " + prefix + t.content + "\n";
        i = i + 1;
    }
    return out;
}

pub fn loop_run(http: &TcpCap, sys: &ProcessCap, state: LoopState, provider: LlmProvider, mcp: McpClient) -> Result[LoopState, String] {
    let prompt: String = loop_build_prompt(state);
    let cr: Result[String, String] = complete(http, provider, prompt);
    let response: String = match cr { Ok(s) => s, Err(e) => return Err("llm: " + e); };
    let tool_name: String = extract_tool_name(response);
    let tool_args: String = extract_tool_args(response);
    if tool_name != "" {
        let ar: Result[String, String] = mcp_call_tool(mcp, sys, tool_name, tool_args);
        let tool_result: String = match ar { Ok(s) => s, Err(e) => "(error: " + e + ")" };
        state = loop_append_tool(state, tool_name, tool_args, tool_result);
        let prompt2: String = loop_build_prompt(state);
        let cr2: Result[String, String] = complete(http, provider, prompt2);
        let final_response: String = match cr2 { Ok(s) => s, Err(e) => return Err("llm2: " + e); };
        state = loop_append_assistant(state, final_response);
    } else {
        state = loop_append_assistant(state, response);
    }
    return Ok(state);
}

fn extract_tool_name(response: String) -> String {
    let key: String = "\"name\":\"";
    let n: Int = chars_len(response);
    let mut i: Int = 0;
    while i < n {
        if str_slice(response, i, i + chars_len(key)) == key {
            i = i + chars_len(key);
            let mut name: String = "";
            while i < n {
                let c: String = str_slice(response, i, i + 1);
                if c == "\"" { return name; }
                name = name + c;
                i = i + 1;
            }
            return name;
        }
        i = i + 1;
    }
    return "";
}

fn extract_tool_args(response: String) -> String {
    let key: String = "\"arguments\":";
    let n: Int = chars_len(response);
    let mut i: Int = 0;
    while i < n {
        if str_slice(response, i, i + chars_len(key)) == key {
            i = i + chars_len(key);
            let mut depth: Int = 0;
            let mut out: String = "";
            while i < n {
                let c: String = str_slice(response, i, i + 1);
                if c == "{" { depth = depth + 1; out = out + c; }
                else if c == "}" { depth = depth - 1; out = out + c; if depth == 0 { return out; } }
                else { out = out + c; }
                i = i + 1;
            }
            return out;
        }
        i = i + 1;
    }
    return "{}";
}
