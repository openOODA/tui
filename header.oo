// # header.oo - Top-of-Screen Header Facade
//
// Logline: Backward-compatible facade forwarding header requests to ui/input/input_header.oo.
//
// Setup: Pure forwarding renderer. Preserves header_render and header_height signatures for legacy callers.
//
// Beats:
//   1. Forward header_render to input_header_render with default build/ask mode.
//   2. Return input_header_height (3) from header_height.
//   3. Expose header_cursor forwarding to input_header_cursor.

import "ui/input/input_header.oo";

pub fn header_render(theme: String, provider: String, model: String, cwd: String, color: Bool, cols: Int) -> String {
    return input_header_render(theme, "", "build", "ask", color, cols);
}

pub fn header_height() -> Int {
    return input_header_height();
}

pub fn header_cursor(color: Bool) -> String {
    return input_header_cursor(color);
}
