// # header.oo - Top-of-Screen Status Bar
//
// Logline: Render the single-line header that sits above the scrollback pane in the line-mode chrome.
//
// Setup: One line. Left = product title. Middle = provider/model. Right = cwd. Tokens: borderAccent, muted.
//
// Beats:
//   1. header_render(theme, provider, model, cwd, cols) returns the SGR-styled single line + newline.
//   2. The header is padded to `cols` characters.
//   3. Empty provider/model/cwd segments are skipped.

import "theme.oo";

pub fn header_render(theme: String, provider: String, model: String, cwd: String, cols: Int) -> String {
    let left: String = "ooda-tui";
    let mut mid: String = "";
    if provider != "" { mid = mid + provider; }
    if model != "" {
        if mid != "" { mid = mid + "/"; }
        mid = mid + model;
    }
    let right: String = cwd;
    let accent: String = theme_color(theme, "borderAccent");
    let muted: String = theme_color(theme, "muted");
    let dim: String = theme_color(theme, "dim");

    let mut s: String = ansi_fg(accent);
    s = s + left + ansi_reset();
    let mut used: Int = chars_len(left);
    if mid != "" {
        let pad1: Int = 2;
        let mut k1: Int = 0;
        while k1 < pad1 { s = s + " "; k1 = k1 + 1; }
        used = used + pad1;
        s = s + ansi_fg(muted) + mid + ansi_reset();
        used = used + chars_len(mid);
    }
    let right_pad: Int = 2;
    let mut remaining: Int = cols - used - right_pad;
    if right != "" { remaining = remaining - chars_len(right); }
    if remaining < 1 { remaining = 1; }
    let mut k2: Int = 0;
    while k2 < remaining { s = s + " "; k2 = k2 + 1; }
    if right != "" {
        s = s + ansi_fg(dim) + right + ansi_reset();
    }
    s = s + "\n";
    return s;
}

pub fn header_height() -> Int {
    return 1;
}
