// # Line-based TUI session (compose box + agent loop)
//
// Logline: Chrome each turn. Slash mutates ReplState. Free-form text runs the tool loop. Pending write/bash waits on y/n/a/d.
//
// Setup: FsRead/Write, ProcessCap, EnvCap. Compose is last so cooked stdin lands in the box.
//
// Beats:
//   1. Load config + AGENTS.md. yolo argv becomes perm=yolo.
//   2. Pending ask intercepts the next line.
//   3. Else slash or agent_run (read/grep/glob/write/bash, 8 hops).

import "std/fs/process/env.oo";
import "std/fs/process/process.oo";
import "chrome.oo";
import "pane.oo";
import "theme.oo";
import "config_io.oo";
import "llm_exec.oo";
import "mcp_client.oo";
import "version.oo";
import "repl_state.oo";
import "repl_slash.oo";
import "agent_turn.oo";
import "agents_md.oo";
import "card.oo";

fn think_of(st: ReplState) -> String {
    if st.pending_tool != "" { return "WAIT"; }
    if st.yolo || st.perm == "yolo" { return "yolo"; }
    if st.mode == "plan" { return "plan"; }
    return st.perm;
}

fn in_buf(st: ReplState) -> String {
    if st.pending_tool != "" { return "ask"; }
    return "";
}

pub fn run_tui_session(fs_r: &FsReadCap, fs_w: &FsWriteCap, sys: &ProcessCap, env: &EnvCap, teamwork: Bool, yolo: Bool, cwd0: String, provider: String, model: String, theme0: String, no_color: Bool) -> Int {
    let mut cwd: String = cwd0;
    if cwd == "" {
        let pr: Result[String, String] = env_get(env, "PWD");
        cwd = match pr { Ok(s) => s, Err(_) => "." };
    }
    let loaded: FlatCfg = config_load_flat(fs_r, env);
    let mut perm: String = "ask";
    if yolo { perm = "yolo"; }
    let mut st: ReplState = ReplState {
        theme: loaded.theme, provider: loaded.provider, ptype: loaded.ptype,
        key: loaded.key, url: loaded.url, model: loaded.model, cwd: cwd,
        teamwork: teamwork, yolo: yolo, plan: "", goal: "", output: "", exiting: false,
        session: "main", hist: "", perm: perm, mode: "build", brief: "",
        pending_tool: "", pending_args: "", pending_body: ""
    };
    if theme0 != "" { st.theme = theme0; }
    if st.theme != "1982" && st.theme != "minimax" { st.theme = "1982"; }
    if provider != "" { st.provider = provider_norm(provider); st.ptype = st.provider; }
    if model != "" { st.model = model; }
    if st.provider != "" && st.model == "" { st.model = provider_default_model(st.provider); }
    if st.provider != "" && st.url == "" { st.url = provider_default_url(st.provider); }
    st.brief = agents_load(fs_r, env, st.cwd);
    let color: Bool = theme_color_forced(env, no_color);
    let ver: String = ooda_tui_version();
    let mut pane: Pane = pane_new();
    pane = pane_append(pane, "ooda " + ver + "  " + st.mode + "/" + st.perm);
    pane = pane_append(pane, "cwd " + st.cwd);
    if st.provider != "" { pane = pane_append(pane, "llm " + st.provider + "/" + st.model); }
    else { pane = pane_append(pane, "llm off  /login muse|minimax|mistral <key>"); }
    if st.brief != "" { pane = pane_append(pane, "brief on"); }
    else { pane = pane_append(pane, "brief off  /init writes AGENTS.md"); }
    pane = mcp_hello(sys, env, pane);
    let host: Bool = have_tty(sys);
    if host { paint_tty(fs_w, sys, chrome_enter_host()); }
    let mut live: Bool = true;
    let mut paint: Bool = true;
    while true {
        if paint {
            let geo: List[Int] = tty_geo(sys);
            let cols: Int = list_get(geo, 0);
            let rows: Int = list_get(geo, 1);
            let frame: String = chrome_render(st.theme, pane, "", 0, in_buf(st), st.teamwork, st.yolo, think_of(st), ver, color, cols, rows, st.provider, st.model, st.cwd);
            paint_frame(fs_w, sys, frame);
            paint = false;
        }
        if !live { break; }
        let cr: Result[String, String] = oo_read_stdin_chunk(fs_r, 200);
        let chunk: String = match cr { Ok(s) => s, Err(_) => "" };
        if chunk == "" && cr.is_err() { live = false; paint = true; }
        else if chunk != "" {
            paint = true;
            let mut cur: String = "";
            let cn: Int = chars_len(chunk);
            let mut ci: Int = 0;
            while ci <= cn {
                let at_end: Bool = ci == cn;
                let ch: String = if at_end { "\n" } else { char_at(chunk, ci) };
                if ch == "\n" || ch == "\r" {
                    let line: String = str_trim(cur);
                    cur = "";
                    if line != "" {
                        st = handle_line(fs_r, fs_w, sys, env, st, line, ver, color);
                        pane = apply_out(pane, st);
                        st.output = "";
                        if st.exiting { live = false; paint = false; }
                    }
                } else { cur = cur + ch; }
                ci = ci + 1;
            }
        }
    }
    if host { paint_tty(fs_w, sys, chrome_leave_host()); }
    return 0;
}

fn apply_out(pane: Pane, st: ReplState) -> Pane {
    if st.output == "__CLEAR__" {
        let p: Pane = pane_new();
        return pane_append(p, "cleared");
    }
    if str_starts_with(st.output, "__COMPACT__") {
        let rest: String = str_trim(str_slice(st.output, 11, chars_len(st.output)));
        return pane_append_block(pane_keep_last(pane, 4), rest);
    }
    if st.output == "" { return pane; }
    return pane_append_block(pane, st.output);
}

fn handle_line(fs_r: &FsReadCap, fs_w: &FsWriteCap, sys: &ProcessCap, env: &EnvCap, st: ReplState, line: String, ver: String, color: Bool) -> ReplState {
    if st.pending_tool != "" { return handle_ask(fs_r, fs_w, sys, st, line, color); }
    if str_starts_with(line, "/") { return slash_line(st, line, ver, sys, fs_w, env, fs_r); }
    if st.provider == "" {
        let mut s: ReplState = st;
        s.output = card_you(line) + "\n" + card_say("no LLM — /login muse|minimax|mistral <key>");
        return s;
    }
    println(card_you(line));
    let mut s: ReplState = agent_run(fs_r, fs_w, sys, st, line, color);
    s.output = card_you(line) + "\n" + s.output;
    return s;
}

fn handle_ask(fs_r: &FsReadCap, fs_w: &FsWriteCap, sys: &ProcessCap, st: ReplState, line: String, color: Bool) -> ReplState {
    let a: String = str_slice(line, 0, 1);
    if a == "y" || a == "Y" { return agent_resume(fs_r, fs_w, sys, st, color); }
    if a == "a" || a == "A" {
        let mut s: ReplState = st;
        s.perm = "allow";
        return agent_resume(fs_r, fs_w, sys, s, color);
    }
    if a == "n" || a == "N" || a == "d" || a == "D" { return agent_deny(st, color); }
    let mut s: ReplState = st;
    s.output = "type y / n / a / d";
    return s;
}

fn pane_append_block(p: Pane, text: String) -> Pane {
    let mut out: Pane = p;
    let mut cur: String = "";
    let n: Int = chars_len(text);
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(text, i);
        if c == "\n" { out = pane_append(out, cur); cur = ""; }
        else { cur = cur + c; }
        i = i + 1;
    }
    if cur != "" { out = pane_append(out, cur); }
    return out;
}

fn have_tty(sys: &ProcessCap) -> Bool {
    let r: Result[String, String] = process_exec(sys, "stty size < /dev/tty 2>/dev/null");
    if r.is_err() { return false; }
    let raw: String = match r { Ok(s) => s, Err(_) => "" };
    return chars_len(str_trim(raw)) >= 3;
}

fn tty_geo(sys: &ProcessCap) -> List[Int] {
    let r: Result[String, String] = process_exec(sys, "stty size < /dev/tty 2>/dev/null");
    if r.is_err() { return chrome_geo_parse(""); }
    let raw: String = match r { Ok(s) => s, Err(_) => "" };
    return chrome_geo_parse(raw);
}

fn paint_tty(fw: &FsWriteCap, sys: &ProcessCap, frame: String) {
    let wr: Result[Void, String] = write_file(fw, "/tmp/.ooda-tui-frame", frame);
    if wr.is_err() { return; }
    let _: Result[String, String] = process_exec(sys, "cat /tmp/.ooda-tui-frame >/dev/tty 2>/dev/null");
}

fn paint_frame(fw: &FsWriteCap, sys: &ProcessCap, frame: String) {
    let wr: Result[Void, String] = write_file(fw, "/tmp/.ooda-tui-frame", frame);
    if wr.is_err() { print(frame); return; }
    let r: Result[String, String] = process_exec(sys, "cat /tmp/.ooda-tui-frame >/dev/tty 2>/dev/null");
    if r.is_err() { print(frame); }
}

fn mcp_hello(sys: &ProcessCap, env: &EnvCap, pane: Pane) -> Pane {
    let cr: Result[String, String] = env_get(env, "OODACODEX");
    let codex: String = match cr { Ok(s) => s, Err(_) => "" };
    let mcp: McpClient = mcp_new(codex, ".", "");
    let ir: Result[String, String] = mcp_init(mcp, sys);
    if ir.is_err() { return pane_append(pane, "mcp off"); }
    return pane_append(pane, "mcp on");
}
