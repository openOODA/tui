// # Line-based TUI session (compose box + slash + LLM)
//
// Logline: Chrome each turn. Slash mutates ReplState. Free-form text goes to curl LLM. Compose line is last so cooked stdin lands in the box.
//
// Setup: FsReadCap stdin; EnvCap color/config; ProcessCap curl/mcp; FsWriteCap llm body and config.
//
// Beats:
//   1. Load flat config, apply argv, probe color.
//   2. Optional ooda-mcp initialize.
//   3. Loop: render, read, slash or LLM. /exit leaves.

import "std/fs/process/env.oo";
import "chrome.oo";
import "pane.oo";
import "theme.oo";
import "config_io.oo";
import "llm_exec.oo";
import "mcp_client.oo";
import "version.oo";
import "repl_state.oo";
import "repl_slash.oo";

pub fn run_tui_session(fs_r: &FsReadCap, fs_w: &FsWriteCap, sys: &ProcessCap, env: &EnvCap, teamwork: Bool, yolo: Bool, cwd0: String, provider: String, model: String, theme0: String, no_color: Bool) -> Int {
    let mut cwd: String = cwd0;
    if cwd == "" {
        let pr: Result[String, String] = env_get(env, "PWD");
        cwd = match pr { Ok(s) => s, Err(_) => "." };
    }
    let loaded: FlatCfg = config_load_flat(fs_r, env);
    let mut st: ReplState = ReplState {
        theme: loaded.theme, provider: loaded.provider, ptype: loaded.ptype,
        key: loaded.key, url: loaded.url, model: loaded.model, cwd: cwd,
        teamwork: teamwork, yolo: yolo, plan: "", goal: "", output: "", exiting: false,
        session: "main", hist: ""
    };
    if theme0 != "" { st.theme = theme0; }
    if st.theme != "1982" && st.theme != "minimax" { st.theme = "1982"; }
    if provider != "" { st.provider = provider_norm(provider); st.ptype = st.provider; }
    if model != "" { st.model = model; }
    if st.provider != "" && st.model == "" { st.model = provider_default_model(st.provider); }
    if st.provider != "" && st.url == "" { st.url = provider_default_url(st.provider); }
    let color: Bool = theme_color_forced(env, no_color);
    let ver: String = ooda_tui_version();
    let mut pane: Pane = pane_new();
    pane = pane_append(pane, "ooda-tui " + ver);
    pane = pane_append(pane, "theme " + st.theme + "  cwd " + st.cwd);
    if st.provider != "" { pane = pane_append(pane, "llm " + st.provider + "/" + st.model); }
    else { pane = pane_append(pane, "llm off  /login muse|minimax|mistral <key>"); }
    pane = mcp_hello(sys, env, pane);
    let mut live: Bool = true;
    let mut paint: Bool = true;
    let cols: Int = chrome_term_cols();
    while true {
        if paint {
            let frame: String = chrome_render(st.theme, pane, "", 0, "", st.teamwork, st.yolo, "off", ver, color, cols, 24, st.provider, st.model, st.cwd);
            println(frame);
            paint = false;
        }
        if !live { break; }
        let cr: Result[String, String] = oo_read_stdin_chunk(fs_r, 200);
        let chunk: String = match cr { Ok(s) => s, Err(_) => "" };
        if chunk == "" && cr.is_err() { live = false; paint = true; }
        else if chunk != "" {
            paint = true;
            let mut cur: String = "";
            let cn: Int = chars_len(chunk);
            let mut ci: Int = 0;
            while ci <= cn {
                let at_end: Bool = ci == cn;
                let ch: String = if at_end { "\n" } else { char_at(chunk, ci) };
                if ch == "\n" || ch == "\r" {
                    let line: String = str_trim(cur);
                    cur = "";
                    if line != "" && str_starts_with(line, "/") {
                        st = slash_line(st, line, ver, sys, fs_w, env);
                        if st.output == "__CLEAR__" {
                            pane = pane_new();
                            pane = pane_append(pane, "cleared");
                            st.output = "";
                        } else if str_starts_with(st.output, "__COMPACT__") {
                            pane = pane_keep_last(pane, 4);
                            st.output = str_trim(str_slice(st.output, 11, chars_len(st.output)));
                            pane = pane_append_block(pane, st.output);
                            st.output = "";
                        } else {
                            pane = pane_append_block(pane, st.output);
                            st.output = "";
                        }
                        if st.exiting { live = false; }
                    } else if line != "" {
                        pane = pane_append(pane, "you  " + line);
                        println("  ...");
                        let reply: String = run_llm_turn(sys, fs_w, st, line);
                        pane = pane_append_block(pane, reply);
                        st.hist = st.hist + "U: " + line + "\nA: " + reply + "\n";
                    }
                } else { cur = cur + ch; }
                ci = ci + 1;
            }
        }
    }
    return 0;
}

fn pane_append_block(p: Pane, text: String) -> Pane {
    let mut out: Pane = p;
    let mut cur: String = "";
    let n: Int = chars_len(text);
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(text, i);
        if c == "\n" { out = pane_append(out, cur); cur = ""; }
        else { cur = cur + c; }
        i = i + 1;
    }
    if cur != "" { out = pane_append(out, cur); }
    return out;
}

fn mcp_hello(sys: &ProcessCap, env: &EnvCap, pane: Pane) -> Pane {
    let cr: Result[String, String] = env_get(env, "OODACODEX");
    let codex: String = match cr { Ok(s) => s, Err(_) => "" };
    let mcp: McpClient = mcp_new(codex, ".", "");
    let ir: Result[String, String] = mcp_init(mcp, sys);
    if ir.is_err() { return pane_append(pane, "mcp off (optional)"); }
    return pane_append(pane, "mcp on");
}

fn run_llm_turn(sys: &ProcessCap, fw: &FsWriteCap, st: ReplState, line: String) -> String {
    if st.provider == "" { return "no LLM — /login muse|minimax|mistral <key>"; }
    let mut prompt: String = line;
    if st.plan != "" { prompt = "PLAN: " + st.plan + "\nGOAL: " + st.goal + "\n" + prompt; }
    if st.teamwork { prompt = "TEAM (lead then review):\n" + prompt; }
    let r: Result[String, String] = llm_complete_exec(sys, fw, st.ptype, st.key, st.model, st.url, prompt);
    return match r { Ok(s) => s, Err(e) => "llm: " + e };
}
