// # Line-based TUI session (v0.1.1 chrome)
//
// Logline: Sit at a prompt, render the line-mode chrome (header + pane + input + status bar) each turn. Slash commands are handled inline (/help, /theme, /login, /exit).
//
// Setup: FsReadCap for stdin, EnvCap for OODACODEX. Uses chrome.oo to compose the frame; pane.oo to keep the scrollback.
//
// Beats:
//   1. Render the chrome once on entry; clear-screen, header, pane, input, status bar.
//   2. Loop: oo_read_stdin_chunk each turn.
//   3. Inline slash dispatcher (just the v0.1.1 commands).
//   4. Otherwise append to the pane and re-render.
//   5. /exit or EOF closes.

import "std/fs/process/env.oo";
import "chrome.oo";
import "pane.oo";
import "popover.oo";
import "theme.oo";
import "keys.oo";

pub fn run_tui_session(fs_r: &FsReadCap, env: &EnvCap, teamwork: Bool, yolo: Bool, cwd0: String, provider: String, model: String, theme: String) -> Int {
    let mut cwd: String = cwd0;
    if cwd == "" {
        let pr: Result[String, String] = env_get(env, "PWD");
        cwd = match pr { Ok(s) => s, Err(_) => "." };
    }
    let mut th: String = theme;
    if th == "" { th = "1982"; }
    if th != "1982" && th != "minimax" { th = "1982"; }

    let mut pane: Pane = pane_new();
    pane = pane_append(pane, ansi_fg(theme_color(th, "borderAccent")) + "ooda-tui v0.1.1" + ansi_reset());
    pane = pane_append(pane, "  theme " + th);
    pane = pane_append(pane, "  cwd " + cwd);
    if provider != "" { pane = pane_append(pane, "  provider " + provider); }
    if model != "" { pane = pane_append(pane, "  model " + model); }
    if teamwork { pane = pane_append(pane, "  teamwork on"); }
    if yolo { pane = pane_append(pane, "  yolo on"); }
    pane = pane_append(pane, "  type /help for commands; /exit to leave");

    let mut live: Bool = true;
    let cols: Int = chrome_term_cols();
    while live {
        let frame: String = chrome_render(th, pane, "", 0, "", teamwork, yolo, "off", "v0.1.1", cols, 24);
        oo_print_str(frame);

        let cr: Result[String, String] = oo_read_stdin_chunk(fs_r, 60000);
        let chunk: String = match cr { Ok(s) => s, Err(_) => "" };
        if chunk == "" && cr.is_err() {
            live = false;
        } else {
            let line: String = str_trim(chunk);
            if line == "/exit" || line == "/quit" {
                live = false;
            } else if line == "/help" {
                pane = pane_append(pane, ansi_fg(theme_color(th, "accent")) + "  /help               this list" + ansi_reset());
                pane = pane_append(pane, "  /theme 1982|minimax switch theme");
                pane = pane_append(pane, "  /login              connect an LLM");
                pane = pane_append(pane, "  /model <name>       set model");
                pane = pane_append(pane, "  /provider <name>    set provider");
                pane = pane_append(pane, "  /cwd <path>         change cwd");
                pane = pane_append(pane, "  /version            print version");
                pane = pane_append(pane, "  /exit /quit         leave");
            } else if str_starts_with(line, "/theme ") {
                let new_th: String = str_trim(str_slice(line, 7, chars_len(line)));
                if new_th == "1982" || new_th == "minimax" {
                    th = new_th;
                    pane = pane_append(pane, ansi_fg(theme_color(th, "success")) + "  theme switched to " + th + ansi_reset());
                } else {
                    pane = pane_append(pane, ansi_fg(theme_color(th, "error")) + "  unknown theme: " + new_th + ansi_reset());
                    pane = pane_append(pane, "  available: 1982 minimax");
                }
            } else if line == "/version" {
                pane = pane_append(pane, "  ooda-tui v0.1.1");
            } else if str_starts_with(line, "/") {
                pane = pane_append(pane, ansi_fg(theme_color(th, "muted")) + "  " + line + ansi_reset());
                pane = pane_append(pane, "  (slash dispatch not yet wired in line mode; see docs/slash.oot)");
            } else if line != "" {
                pane = pane_append(pane, ansi_fg(theme_color(th, "muted")) + "> " + line + ansi_reset());
                pane = pane_append(pane, "  (no LLM connected yet — /login)");
            }
        }
    }
    return 0;
}
