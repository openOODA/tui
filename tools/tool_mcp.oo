// # tools/tool_mcp.oo - Sandboxed Model Context Protocol Tool Caller
//
// Logline: Invokes external MCP server tools via JSON-RPC protocol over stdio subprocess.
//
// Setup: Connects to ooda-mcp via McpClient, executes tools/call, and clips response text.
//
// Beats:
//   1. Rejects empty tool names fail-closed.
//   2. Instantiates McpClient bound to cwd and process capabilities.
//   3. Dispatches tool call request to ooda-mcp server.
//   4. Extracts response text or raw JSON envelope and clips to 8000 characters.

import "./path_guard.oo";
import "mcp_client.oo";

fn resolve_codex(sys: &ProcessCap) -> String {
    let r: Result[String, String] = process_exec(sys, "if [ -n \"$OODACODEX\" ]; then echo -n \"$OODACODEX\"; elif [ -f \"$HOME/.openooda/northstar.oot\" ]; then echo -n \"$HOME/.openooda/northstar.oot\"; else echo -n \"\"; fi");
    return match r { Ok(s) => str_trim(s), Err(_) => "" };
}

pub fn tool_mcp_call(fw: &FsWriteCap, sys: &ProcessCap, cwd: String, tool_name: String, args_json: String) -> Result[String, String] {
    if str_trim(tool_name) == "" { return Err("empty MCP tool name"); }
    let codex: String = resolve_codex(sys);
    let client: McpClient = mcp_new(codex, cwd, "");
    let r: Result[String, String] = mcp_call_tool(client, fw, sys, tool_name, args_json);
    let _ = mcp_close(client);
    if r.is_err() {
        let e: String = match r { Ok(_) => "", Err(m) => m };
        return Err(path_clip(e));
    }
    let res: String = match r { Ok(s) => s, Err(_) => "" };
    let text: String = mcp_extract_result_text(res);
    if text != "" { return Ok(path_clip(text)); }
    return Ok(path_clip(res));
}

pub fn tool_mcp_list(fw: &FsWriteCap, sys: &ProcessCap, cwd: String) -> Result[String, String] {
    let codex: String = resolve_codex(sys);
    let client: McpClient = mcp_new(codex, cwd, "");
    let r: Result[String, String] = mcp_list_tools(client, fw, sys);
    let _ = mcp_close(client);
    if r.is_err() {
        let e: String = match r { Ok(_) => "", Err(m) => m };
        return Err(path_clip(e));
    }
    let res: String = match r { Ok(s) => s, Err(_) => "" };
    return Ok(path_clip(res));
}

pub fn tool_mcp(fw: &FsWriteCap, sys: &ProcessCap, cwd: String, tool_name: String, args_json: String) -> Result[String, String] {
    return tool_mcp_call(fw, sys, cwd, tool_name, args_json);
}
