// # chrome.oo - Line-Mode Frame Renderer
//
// Logline: Full-window frame: header prompt box, flex pane, status, trailing cursor placement.
//
// Setup: Pure renderer. Returns a single String ready to be written to stdout. Uses ui/input/input_header.oo / pane.oo / popover.oo / statusbar.oo. ANSI clear is ESC[2J ESC[H; cursor positioned at prompt row.
//
// Beats:
//   1. chrome_render(theme, pane, popover_buf, popover_idx, input_buf, ..., color, cols, rows) returns the full frame.
//   2. Rows 1-3 render the top input header box with mode chips and keyboard hints.
//   3. Rows 4 to rows-1 render the scrollback pane; popover (if any) sits above the status bar.
//   4. Row rows renders the environmental status bar at the screen bottom.
//   5. Emits trailing cursor placement sequence (ESC[2;5H in color mode) at frame end.

import "ui/input/input_header.oo";
import "header.oo";
import "pane.oo";
import "popover.oo";
import "statusbar.oo";
import "ui/statusbar/statusbar_footer.oo";
import "theme.oo";

pub fn chrome_render(theme: String, pane: Pane, popover_buf: String, popover_idx: Int, input_buf: String, teamwork: Bool, yolo: Bool, thinking: String, version: String, color: Bool, cols: Int, rows: Int, provider: String, model: String, cwd: String) -> String {
    let mut s: String = "";
    if color { s = ansi_esc() + "[2J" + ansi_esc() + "[H"; }
    let mut ph: Int = rows - 4;
    if popover_buf != "" { ph = ph - 1; }
    if ph < 3 { ph = 3; }

    let mut mode: String = "build";
    if input_buf == "plan" { mode = "plan"; }
    else if input_buf == "ask" { mode = "ask"; }

    let mut perm: String = "ask";
    if yolo { perm = "yolo"; }
    else if input_buf == "ask" { perm = "ask"; }

    let mut h_buf: String = "";
    if input_buf != "plan" && input_buf != "ask" && input_buf != "build" {
        h_buf = input_buf;
    }

    s = s + input_header_render(theme, h_buf, mode, perm, color, cols);
    s = s + pane_render(theme, pane.lines, color, cols, ph);
    if popover_buf != "" {
        s = s + popover_render(theme, popover_buf, popover_idx, color, cols);
    }
    let mcp_ok: Bool = true;
    let lsp_ok: Bool = true;
    s = s + statusbar_footer_render(theme, provider, model, cwd, mode, perm, thinking, teamwork, mcp_ok, lsp_ok, version, color, cols);
    s = s + input_header_cursor(color);
    return s;
}

pub fn chrome_enter_host() -> String {
    return ansi_esc() + "[?1049h" + ansi_esc() + "[2J" + ansi_esc() + "[H" + ansi_esc() + "[?25h";
}

pub fn chrome_leave_host() -> String {
    return ansi_esc() + "[?1049l";
}

fn digit_val(c: String) -> Int {
    let d: String = "0123456789";
    let mut i: Int = 0;
    while i < 10 {
        if char_at(d, i) == c { return i; }
        i = i + 1;
    }
    return -1;
}

pub fn chrome_geo_parse(raw: String) -> List[Int] {
    let mut rows: Int = 24;
    let mut cols: Int = 80;
    let n: Int = chars_len(raw);
    let mut i: Int = 0;
    let mut acc: Int = 0;
    let mut got: Bool = false;
    while i < n {
        let c: String = char_at(raw, i);
        let v: Int = digit_val(c);
        if v >= 0 { acc = acc * 10 + v; got = true; }
        else if got { rows = acc; break; }
        i = i + 1;
    }
    acc = 0;
    got = false;
    while i < n {
        let c: String = char_at(raw, i);
        let v: Int = digit_val(c);
        if v >= 0 { acc = acc * 10 + v; got = true; }
        else if got { cols = acc; break; }
        i = i + 1;
    }
    if got { cols = acc; }
    if rows < 12 { rows = 12; }
    if cols < 40 { cols = 40; }
    if rows > 80 { rows = 80; }
    if cols > 200 { cols = 200; }
    let mut out: List[Int] = list_new();
    out = list_push(out, cols);
    out = list_push(out, rows);
    return out;
}

pub fn chrome_clear_only() -> String {
    return ansi_esc() + "[2J" + ansi_esc() + "[H";
}

pub fn chrome_default_cols() -> Int {
    return 80;
}

pub fn chrome_default_rows() -> Int {
    return 24;
}

pub fn chrome_term_cols() -> Int {
    return 80;
}

pub fn chrome_term_rows() -> Int {
    return 24;
}
