// # tui version stamp
//
// Logline: Single source for the binary version string. Imported by main, repl, mcp_client, and the anchor.
//
// Setup: Pure data. Override at runtime with OODA_TUI_VERSION.
//
// Beats:
//   1. tui_version() returns the release tag for this tree.

pub fn tui_version() -> String {
    return "v0.3.10";
}
