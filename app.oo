// # app.oo - TUI Shell
//
// Logline: The top-level loop. Reads a line of input, dispatches to slash.oo (if /), keys.oo (if ctrl-?), or loop.oo (free-form).
//
// Setup: Imports slash.oo, loop.oo, keys.oo, config.oo, theme.oo. The shell is line-based (stdin line) for v0.1; raw TTY mode is a future enhancement.
//
// Beats:
//   1. Render the status line: mode, provider/model, tokens, cwd, session, flags.
//   2. Render the prompt "> ".
//   3. Read a line from stdin.
//   4. If line starts with "/", dispatch to slash.oo.
//   5. If line is a control char (e.g., starts with "<ctrl:t>"), dispatch to keys.oo.
//   6. Else, append to loop state and call loop_run.
//   7. Print the assistant response.
//   8. Repeat until /exit or EOF.

import "loop.oo";
import "keys.oo";
import "config.oo";
import "theme.oo";
import "session.oo";

type AppState = struct {
    cfg: Config,
    loop_state: LoopState,
    session: Session,
    teamwork: Bool,
    yolo: Bool,
    theme: String,
    provider_name: String,
    model_name: String
};

pub fn app_state_new(cfg: Config, session: Session, teamwork: Bool, yolo: Bool) -> AppState {
    let ls: LoopState = loop_state_new();
    return AppState { cfg: cfg, loop_state: ls, session: session, teamwork: teamwork, yolo: yolo, theme: cfg.theme, provider_name: cfg.default_provider, model_name: cfg.default_model };
}

pub fn render_status_line(state: AppState) -> String {
    let mut out: String = "[";
    if state.teamwork { out = out + "teamwork"; } else { out = out + "code"; }
    out = out + "] " + state.provider_name + "/" + state.model_name + " - cwd " + state.session.cwd + " - session " + state.session.sid;
    if state.yolo { out = out + " - yolo"; }
    return out + "\n";
}

pub fn render_prompt(state: AppState) -> String {
    return "> ";
}

pub fn app_render(state: AppState) -> String {
    let mut out: String = theme_color(state.theme, "text");
    out = out + render_status_line(state);
    out = out + theme_color(state.theme, "dim");
    out = out + "  cwd: " + state.session.cwd + "\n";
    out = out + theme_color(state.theme, "text");
    return out;
}

pub fn app_handle_key(state: AppState, key_name: String) -> AppState {
    let action: String = key_action(key_name);
    if action == "toggle_teamwork" {
        let mut t: Bool = state.teamwork;
        if t { t = false; } else { t = true; }
        state.teamwork = t;
        return state;
    }
    if action == "toggle_yolo" {
        let mut y: Bool = state.yolo;
        if y { y = false; } else { y = true; }
        state.yolo = y;
        return state;
    }
    return state;
}

pub fn app_handle_main(state: AppState, line: String) -> AppState {
    state.loop_state = loop_append_user(state.loop_state, line);
    return state;
}

pub fn app_run_once(http: &TcpCap, sys: &ProcessCap, state: AppState, provider: LlmProvider, mcp: McpClient, line: String) -> Result[AppState, String] {
    let trimmed: String = str_trim(line);
    if chars_len(trimmed) == 0 { return Ok(state); }
    if str_starts_with(trimmed, "/") {
        return Ok(state);
    }
    if str_starts_with(trimmed, "<ctrl:") {
        let key_name: String = extract_key_name(trimmed);
        return Ok(app_handle_key(state, key_name));
    }
    let s2: AppState = app_handle_main(state, trimmed);
    return Ok(s2);
}

fn extract_key_name(s: String) -> String {
    let n: Int = chars_len(s);
    let mut i: Int = 6;
    let mut out: String = "";
    while i < n {
        let c: String = str_slice(s, i, i + 1);
        if c == ">" { return out; }
        out = out + c;
        i = i + 1;
    }
    return out;
}

pub fn app_session_save(sys: &ProcessCap, env: &EnvCap, state: AppState) -> Result[Int, String] {
    let transcript: String = loop_serialize(state.loop_state);
    let plan: String = "";
    let goal: String = "";
    return session_save(sys, env, state.session, transcript, plan, goal);
}

fn loop_serialize(state: LoopState) -> String {
    let mut out: String = "";
    let n: Int = list_len(state.turns);
    let mut i: Int = 0;
    while i < n {
        let t: LoopTurn = list_get(state.turns, i);
        out = out + "{\"role\":\"" + t.role + "\",\"kind\":\"" + t.kind + "\",\"content\":\"" + lsp_escape_inline(t.content) + "\"}\n";
        i = i + 1;
    }
    return out;
}

fn lsp_escape_inline(s: String) -> String {
    let mut out: String = "";
    let n: Int = chars_len(s);
    let mut i: Int = 0;
    while i < n {
        let c: String = str_slice(s, i, i + 1);
        if c == "\"" { out = out + "\\\""; }
        else if c == "\\" { out = out + "\\\\"; }
        else if c == "\n" { out = out + "\\n"; }
        else { out = out + c; }
        i = i + 1;
    }
    return out;
}
