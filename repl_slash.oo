// # repl_slash.oo - Slash Command Dispatch Bridge
//
// Logline: Backward-compatible bridge delegating slash commands to the modular slash/ subsystem.
//
// Setup: Imports slash/anchor.oo and delegates slash_line to slash_dispatch.
//
// Beats:
//   1. Forward slash_line to slash_dispatch.
//   2. Preserve backward compatibility with existing callers and test probes.

import "slash/anchor.oo";

pub fn slash_line(st: ReplState, line: String, ver: String, sys: &ProcessCap, fw: &FsWriteCap, env: &EnvCap, fs_r: &FsReadCap) -> ReplState {
    return slash_dispatch(st, line, ver, sys, fw, env, fs_r);
}
