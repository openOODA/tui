// # statusbar.oo - Bottom Frame Status Divider Facade
//
// Logline: Backward-compatible facade delegating statusbar rendering to ui/statusbar/statusbar_footer.oo.
//
// Setup: Pure forwarding facade. Preserves statusbar_render and statusbar_height signatures for legacy callers.
//
// Beats:
//   1. Forward statusbar_render to statusbar_footer_render with default telemetry bindings.
//   2. Return statusbar_footer_height (1) from statusbar_height.
//   3. Re-export statusbar_footer_render for direct statusbar callers.

import "ui/statusbar/statusbar_footer.oo";

pub fn statusbar_render(theme: String, teamwork: Bool, yolo: Bool, thinking: String, version: String, color: Bool, cols: Int) -> String {
    let mut perm: String = if yolo { "yolo" } else { "ask" };
    let mut mode: String = "build";
    if thinking == "plan" { mode = "plan"; }
    else if thinking == "WAIT" { mode = "ask"; }
    return statusbar_footer_render(theme, "", "", "", mode, perm, thinking, teamwork, true, true, version, color, cols);
}

pub fn statusbar_height() -> Int {
    return statusbar_footer_height();
}
