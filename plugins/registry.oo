        i = i + 1;
    }
    return Err("unknown tool: " + name);
}
pub fn registry_has_tool(reg: Registry, name: String) -> Bool { return registry_get_tool(reg, name).is_ok(); }
pub fn registry_list_tools(reg: Registry) -> List[String] {
