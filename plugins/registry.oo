// # plugins/registry.oo - Master Typed Plugin Registry
//
// Logline: Central typed registry maintaining zero hardcoded commands or tools with fail-closed query and dispatch.
//
// Setup: Flat registry records for input, indicator, card, slash, tool, and workflow preset plugins.
//
// Beats:
//   1. Typed plugin definitions across 6 domains (Input, Indicator, Card, Slash, Tool, Preset).
//   2. Capability record ToolCaps for capability-gated dispatch.
//   3. Registry constructors and registration methods for all 6 domains.
//   4. Query functions (has, get, list) with fail-closed Result returns.
//   5. Fail-closed dispatch mechanisms for slash commands, tools, and presets.

pub type InputPlugin = struct {
    name: String, description: String, kind: String, height: Int, enabled: Bool
};
pub type IndicatorPlugin = struct {
    name: String, description: String, style: String, enabled: Bool
};
pub type CardPlugin = struct {
    name: String, description: String, style: String, enabled: Bool
};
pub type SlashPlugin = struct {
    name: String, description: String, usage: String, is_external: Bool, script_path: String, enabled: Bool
};
pub type ToolPlugin = struct {
    name: String, description: String, needs_ask: Bool, required_cap: String, is_external: Bool, enabled: Bool
};
pub type PresetPlugin = struct {
    name: String, description: String, input_plugin: String, indicator_plugin: String, card_plugin: String, default_mode: String, default_perm: String, theme: String, enabled: Bool
};
pub type ToolCaps = struct {
    can_read: Bool, can_write: Bool, can_bash: Bool, can_net: Bool, can_mcp: Bool, can_lsp: Bool
};
pub type Registry = struct {
    inputs: List[InputPlugin], indicators: List[IndicatorPlugin], cards: List[CardPlugin], slash_commands: List[SlashPlugin], tools: List[ToolPlugin], presets: List[PresetPlugin]
};

pub fn tool_caps_new(r: Bool, w: Bool, b: Bool, n: Bool, m: Bool, l: Bool) -> ToolCaps {
    return ToolCaps { can_read: r, can_write: w, can_bash: b, can_net: n, can_mcp: m, can_lsp: l };
}
pub fn tool_caps_default() -> ToolCaps { return ToolCaps { can_read: true, can_write: false, can_bash: false, can_net: false, can_mcp: true, can_lsp: true }; }
pub fn tool_caps_yolo() -> ToolCaps { return ToolCaps { can_read: true, can_write: true, can_bash: true, can_net: true, can_mcp: true, can_lsp: true }; }

pub fn registry_init() -> Registry {
    return Registry { inputs: list_new(), indicators: list_new(), cards: list_new(), slash_commands: list_new(), tools: list_new(), presets: list_new() };
}

pub fn registry_register_input(reg: Registry, p: InputPlugin) -> Registry {
    let mut r: Registry = reg; r.inputs = list_push(r.inputs, p); return r;
}
pub fn registry_get_input(reg: Registry, name: String) -> Result[InputPlugin, String] {
    let n: Int = list_len(reg.inputs); let mut i: Int = 0;
    while i < n {
        let p: InputPlugin = list_get(reg.inputs, i);
        if p.name == name { return Ok(p); }
        i = i + 1;
    }
    return Err("unknown input plugin: " + name);
}
pub fn registry_has_input(reg: Registry, name: String) -> Bool { return registry_get_input(reg, name).is_ok(); }
pub fn registry_list_inputs(reg: Registry) -> List[String] {
    let mut out: List[String] = list_new(); let n: Int = list_len(reg.inputs); let mut i: Int = 0;
    while i < n { out = list_push(out, list_get(reg.inputs, i).name); i = i + 1; }
    return out;
}

