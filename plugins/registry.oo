    while i < n { out = list_push(out, list_get(reg.tools, i).name); i = i + 1; }
    return out;
}
pub fn registry_tool_needs_ask(reg: Registry, name: String) -> Bool {
    let tr: Result[ToolPlugin, String] = registry_get_tool(reg, name);
    if tr.is_err() { return true; }
    let tool: ToolPlugin = match tr { Ok(t) => t, Err(_) => return true; };
    return tool.needs_ask;
}

pub fn registry_register_preset(reg: Registry, p: PresetPlugin) -> Registry {
    let mut r: Registry = reg; r.presets = list_push(r.presets, p); return r;
}
pub fn registry_get_preset(reg: Registry, name: String) -> Result[PresetPlugin, String] {
    let n: Int = list_len(reg.presets); let mut i: Int = 0;
    while i < n {
        let p: PresetPlugin = list_get(reg.presets, i);
        if p.name == name { return Ok(p); }
        i = i + 1;
    }
    return Err("unknown preset: " + name);
}
pub fn registry_has_preset(reg: Registry, name: String) -> Bool { return registry_get_preset(reg, name).is_ok(); }
pub fn registry_list_presets(reg: Registry) -> List[String] {
    let mut out: List[String] = list_new(); let n: Int = list_len(reg.presets); let mut i: Int = 0;
    while i < n { out = list_push(out, list_get(reg.presets, i).name); i = i + 1; }
    return out;
}
pub fn registry_resolve_preset(reg: Registry, name: String) -> Result[PresetPlugin, String] {
    if name == "" { return Err("empty preset name"); }
    let pr: Result[PresetPlugin, String] = registry_get_preset(reg, name);
    if pr.is_err() { return Err("unknown preset: " + name); }
    let p: PresetPlugin = match pr { Ok(v) => v, Err(e) => return Err(e); };
    if !p.enabled { return Err("preset is disabled: " + name); }
    return Ok(p);
}

fn contains_meta(s: String) -> Bool {
    let n: Int = chars_len(s); let mut i: Int = 0;
    while i < n {
        let c: String = char_at(s, i);
        if c == "/" || c == ";" || c == "&" || c == "|" || c == "`" || c == "$" || c == "\n" { return true; }
        i = i + 1;
    }
    return false;
}

pub fn registry_dispatch_slash(reg: Registry, cmd: String, args: String) -> Result[String, String] {
    if cmd == "" { return Err("empty slash command"); }
    if contains_meta(cmd) { return Err("SECURITY: invalid characters in slash command: " + cmd); }
    let pr: Result[SlashPlugin, String] = registry_get_slash(reg, cmd);
    if pr.is_err() { return Err("unknown slash command: /" + cmd); }
    let p: SlashPlugin = match pr { Ok(v) => v, Err(e) => return Err(e); };
    if !p.enabled { return Err("slash command is disabled: /" + cmd); }
    if p.is_external { return Ok("external:" + p.script_path); }
    return Ok("builtin:" + cmd);
}

pub fn registry_dispatch_tool(reg: Registry, name: String, args: String, caps: ToolCaps) -> Result[String, String] {
    if name == "" { return Err("empty tool name"); }
    let tr: Result[ToolPlugin, String] = registry_get_tool(reg, name);
    if tr.is_err() { return Err("unknown tool: " + name); }
    let tool: ToolPlugin = match tr { Ok(t) => t, Err(e) => return Err(e); };
    if !tool.enabled { return Err("tool is disabled: " + name); }
    let req: String = tool.required_cap;
    if req == "read" && !caps.can_read { return Err("permission denied: read capability required for " + name); }
    if req == "write" && !caps.can_write { return Err("permission denied: write capability required for " + name); }
    if req == "bash" && !caps.can_bash { return Err("permission denied: bash capability required for " + name); }
    if req == "net" && !caps.can_net { return Err("permission denied: net capability required for " + name); }
    if req == "mcp" && !caps.can_mcp { return Err("permission denied: mcp capability required for " + name); }
    if req == "lsp" && !caps.can_lsp { return Err("permission denied: lsp capability required for " + name); }
    if req != "" && req != "read" && req != "write" && req != "bash" && req != "net" && req != "mcp" && req != "lsp" {
        return Err("permission denied: unknown required capability: " + req);
    }
    return Ok(name);
}
