// # slash/cmd_goal.oo - Goal Slash Command
//
// Logline: Query or set current operational objective goal in session state.
//
// Setup: Inspects or mutates active goal string in ReplState.
//
// Beats:
//   1. Query current active goal if args empty.
//   2. Update operational goal in ReplState.
//   3. Emit confirmation notice to session output.


pub fn cmd_goal_run(st: ReplState, args: String) -> ReplState {
    if args == "" { return slash_say(st, "goal: " + st.goal); }
    let mut s: ReplState = st;
    s.goal = args;
    return slash_say(s, "goal: set");
}
