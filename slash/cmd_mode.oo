// # slash/cmd_mode.oo - Mode Slash Command
//
// Logline: Query or mutate operational workflow mode (build or plan).
//
// Setup: Validates operational mode and updates ReplState.mode.
//
// Beats:
//   1. Query active mode if args empty.
//   2. Validate operational mode (build, plan).
//   3. Mutate mode string in ReplState.
//   4. Emit confirmation to session output.


pub fn cmd_mode_run(st: ReplState, args: String) -> ReplState {
    if args == "" { return slash_say(st, "mode: " + st.mode); }
    if args != "build" && args != "plan" { return slash_say(st, "mode: build|plan"); }
    let mut s: ReplState = st;
    s.mode = args;
    return slash_say(s, "mode: " + args);
}
