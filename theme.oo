// # Theme Loader - ANSI Renderer
//
// Logline: Load a theme module by name and render hex codes as ANSI SGR escape sequences. Thread a `color: Bool` flag through every renderer so the chrome degrades to plain text when NO_COLOR / TERM=dumb is set.
//
// Setup: Reads themes/<name>.oo. For v0.2, "1982" and "minimax" are wired via theme_color.
//
// Beats:
//   1. theme_color(name, token) returns the theme's name string.
//   2. theme_color_session(env) probes NO_COLOR / TERM=dumb / TERM="" and returns false when color must be suppressed.
//   3. ansi_fg(color, hex) and ansi_bg(color, hex) render SGR escape codes from "#RRGGBB"; return "" when color is false.
//   4. ansi_reset(color) returns the standard reset sequence; "" when color is false.
//   5. ansi_combine(color, fg, bg, attr) emits a single SGR prefix; "" when color is false.
//   6. theme_render_cell(color, fg, bg, attr) returns the SGR prefix for one cell.

import "std/fs/process/env.oo";
import "themes/1982.oo";
import "themes/minimax.oo";

pub fn theme_color(name: String, token: String) -> String {
    if name == "1982" { return theme_1982_token(token); }
    if name == "minimax" { return theme_minimax_token(token); }
    return theme_1982_token(token);
}

pub fn theme_list() -> String {
    return "1982 minimax";
}

// EnvCap only exposes OODA_/OO_ keys, so TERM and NO_COLOR cannot be read.
// Color is on unless OODA_NO_COLOR is set. --no-color is handled by theme_color_forced.
pub fn theme_color_session(env: &EnvCap) -> Bool {
    let nr: Result[String, String] = env_get(env, "OODA_NO_COLOR");
    if nr.is_ok() {
        let n: String = match nr { Ok(s) => s, Err(_) => "" };
        if n != "" { return false; }
    }
    return true;
}

// openOODA string literals do not parse \xHH. Build ESC (byte 27) from a byte.
pub fn ansi_esc() -> String {
    return bytes_to_str(bytes_push(bytes_new(), 27));
}

// Honor an explicit --no-color flag in addition to the env probe.
pub fn theme_color_forced(env: &EnvCap, no_color: Bool) -> Bool {
    if no_color { return false; }
    return theme_color_session(env);
}

pub fn ansi_fg(color: Bool, hex: String) -> String {
    if !color { return ""; }
    let r: Int = hex_to_r(hex);
    let g: Int = hex_to_g(hex);
    let b: Int = hex_to_b(hex);
    return ansi_esc() + "[38;2;" + int_to_str(r) + ";" + int_to_str(g) + ";" + int_to_str(b) + "m";
}

pub fn ansi_bg(color: Bool, hex: String) -> String {
    if !color { return ""; }
    let r: Int = hex_to_r(hex);
    let g: Int = hex_to_g(hex);
    let b: Int = hex_to_b(hex);
    return ansi_esc() + "[48;2;" + int_to_str(r) + ";" + int_to_str(g) + ";" + int_to_str(b) + "m";
}

pub fn ansi_reset(color: Bool) -> String {
    if !color { return ""; }
    return ansi_esc() + "[0m";
}

pub fn ansi_bold(color: Bool) -> String {
    if !color { return ""; }
    return ansi_esc() + "[1m";
}

pub fn ansi_italic(color: Bool) -> String {
    if !color { return ""; }
    return ansi_esc() + "[3m";
}

pub fn ansi_underline(color: Bool) -> String {
    if !color { return ""; }
    return ansi_esc() + "[4m";
}

// Compose a single SGR prefix from fg/bg hex codes and attribute flags.
// attr is a 3-bit mask: bit0=bold bit1=italic bit2=underline.
// Returns the empty string when color is false OR when fg == "" and bg == "" and attr == 0.
pub fn ansi_combine(color: Bool, fg: String, bg: String, attr: Int) -> String {
    if !color { return ""; }
    let mut s: String = "";
    if attr & 1 == 1 { s = s + ansi_bold(color); }
    if attr & 2 == 2 { s = s + ansi_italic(color); }
    if attr & 4 == 4 { s = s + ansi_underline(color); }
    if fg != "" { s = s + ansi_fg(color, fg); }
    if bg != "" { s = s + ansi_bg(color, bg); }
    return s;
}

// Render one cell. Returns the SGR prefix only; the caller writes the
// glyph and then ansi_reset(color). Empty fg + bg + attr means "no SGR,
// inherit previous state".
pub fn theme_render_cell(color: Bool, fg: String, bg: String, attr: Int) -> String {
    return ansi_combine(color, fg, bg, attr);
}

// Hex digit -> value 0..15. Accepts both cases.
fn hex_digit_val(c: String) -> Int {
    if c == "0" { return 0; }
    if c == "1" { return 1; }
    if c == "2" { return 2; }
    if c == "3" { return 3; }
    if c == "4" { return 4; }
    if c == "5" { return 5; }
    if c == "6" { return 6; }
    if c == "7" { return 7; }
    if c == "8" { return 8; }
    if c == "9" { return 9; }
    if c == "a" { return 10; }
    if c == "A" { return 10; }
    if c == "b" { return 11; }
    if c == "B" { return 11; }
    if c == "c" { return 12; }
    if c == "C" { return 12; }
    if c == "d" { return 13; }
    if c == "D" { return 13; }
    if c == "e" { return 14; }
    if c == "E" { return 14; }
    if c == "f" { return 15; }
    if c == "F" { return 15; }
    return 0;
}

// Parse two hex digits at hex[hi],hex[lo] into a 0..255 byte.
fn hex_pair(hex: String, hi: Int, lo: Int) -> Int {
    let h: Int = hex_digit_val(char_at(hex, hi));
    let l: Int = hex_digit_val(char_at(hex, lo));
    return h * 16 + l;
}

fn hex_to_r(hex: String) -> Int { return hex_pair(hex, 1, 2); }
fn hex_to_g(hex: String) -> Int { return hex_pair(hex, 3, 4); }
fn hex_to_b(hex: String) -> Int { return hex_pair(hex, 5, 6); }

// Local int_to_str: 0..255 only (RGB channels). Negative -> "0".
fn int_to_str(n: Int) -> String {
    if n < 0 { return "0"; }
    if n == 0 { return "0"; }
    let digits: String = "0123456789";
    let mut v: Int = n;
    let mut rev: String = "";
    while v > 0 {
        let d: Int = v - (v / 10) * 10;
        rev = rev + char_at(digits, d);
        v = v / 10;
    }
    let mut out: String = "";
    let mut k: Int = chars_len(rev) - 1;
    while k >= 0 {
        out = out + char_at(rev, k);
        k = k - 1;
    }
    return out;
}
