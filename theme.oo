// # Theme Loader - ANSI Renderer
//
// Logline: Load a theme module by name and render hex codes as ANSI SGR escape sequences.
//
// Setup: Reads themes/<name>.oo. For v0.2, "1982" and "minimax" are wired via theme_color.
//
// Beats:
//   1. theme_load(name) returns the theme's name string.
//   2. theme_color(name, token) returns the hex code for a semantic token.
//   3. ansi_fg(hex) and ansi_bg(hex) render SGR escape codes from "#RRGGBB".
//   4. ansi_reset() returns the standard reset sequence.
//   5. ansi_combine(fg, bg, bold, italic, underline) emits a single SGR prefix.
//   6. theme_render_cell(fg, bg, attrs) returns the SGR prefix for one cell.

import "themes/1982.oo";
import "themes/minimax.oo";

pub fn theme_color(name: String, token: String) -> String {
    if name == "1982" { return theme_1982_token(token); }
    if name == "minimax" { return theme_minimax_token(token); }
    return theme_1982_token(token);
}

pub fn theme_list() -> String {
    return "1982 minimax";
}

pub fn ansi_fg(hex: String) -> String {
    let r: Int = hex_to_r(hex);
    let g: Int = hex_to_g(hex);
    let b: Int = hex_to_b(hex);
    return "\x1b[38;2;" + int_to_str(r) + ";" + int_to_str(g) + ";" + int_to_str(b) + "m";
}

pub fn ansi_bg(hex: String) -> String {
    let r: Int = hex_to_r(hex);
    let g: Int = hex_to_g(hex);
    let b: Int = hex_to_b(hex);
    return "\x1b[48;2;" + int_to_str(r) + ";" + int_to_str(g) + ";" + int_to_str(b) + "m";
}

pub fn ansi_reset() -> String {
    return "\x1b[0m";
}

pub fn ansi_bold() -> String {
    return "\x1b[1m";
}

pub fn ansi_italic() -> String {
    return "\x1b[3m";
}

pub fn ansi_underline() -> String {
    return "\x1b[4m";
}

// Compose a single SGR prefix from fg/bg hex codes and attribute flags.
// attr is a 3-bit mask: bit0=bold bit1=italic bit2=underline.
// Returns the empty string when fg == "" and bg == "" and attr == 0.
pub fn ansi_combine(fg: String, bg: String, attr: Int) -> String {
    let mut s: String = "";
    if attr & 1 == 1 { s = s + ansi_bold(); }
    if attr & 2 == 2 { s = s + ansi_italic(); }
    if attr & 4 == 4 { s = s + ansi_underline(); }
    if fg != "" { s = s + ansi_fg(fg); }
    if bg != "" { s = s + ansi_bg(bg); }
    return s;
}

// Render one cell. Returns the SGR prefix only; the caller writes the
// glyph and then ansi_reset(). Empty fg + bg + attr means "no SGR,
// inherit previous state".
pub fn theme_render_cell(fg: String, bg: String, attr: Int) -> String {
    return ansi_combine(fg, bg, attr);
}

// Hex digit -> value 0..15. Accepts both cases.
fn hex_digit_val(c: String) -> Int {
    if c == "0" { return 0; }
    if c == "1" { return 1; }
    if c == "2" { return 2; }
    if c == "3" { return 3; }
    if c == "4" { return 4; }
    if c == "5" { return 5; }
    if c == "6" { return 6; }
    if c == "7" { return 7; }
    if c == "8" { return 8; }
    if c == "9" { return 9; }
    if c == "a" { return 10; }
    if c == "A" { return 10; }
    if c == "b" { return 11; }
    if c == "B" { return 11; }
    if c == "c" { return 12; }
    if c == "C" { return 12; }
    if c == "d" { return 13; }
    if c == "D" { return 13; }
    if c == "e" { return 14; }
    if c == "E" { return 14; }
    if c == "f" { return 15; }
    if c == "F" { return 15; }
    return 0;
}

// Parse two hex digits at hex[hi],hex[lo] into a 0..255 byte.
fn hex_pair(hex: String, hi: Int, lo: Int) -> Int {
    let h: Int = hex_digit_val(char_at(hex, hi));
    let l: Int = hex_digit_val(char_at(hex, lo));
    return h * 16 + l;
}

fn hex_to_r(hex: String) -> Int { return hex_pair(hex, 1, 2); }
fn hex_to_g(hex: String) -> Int { return hex_pair(hex, 3, 4); }
fn hex_to_b(hex: String) -> Int { return hex_pair(hex, 5, 6); }

// Local int_to_str: 0..255 only (RGB channels). Negative -> "0".
fn int_to_str(n: Int) -> String {
    if n < 0 { return "0"; }
    if n == 0 { return "0"; }
    let digits: String = "0123456789";
    let mut v: Int = n;
    let mut rev: String = "";
    while v > 0 {
        let d: Int = v - (v / 10) * 10;
        rev = rev + char_at(digits, d);
        v = v / 10;
    }
    let mut out: String = "";
    let mut k: Int = chars_len(rev) - 1;
    while k >= 0 {
        out = out + char_at(rev, k);
        k = k - 1;
    }
    return out;
}
