// # card.oo - Visual Component Cards and Dialogs
//
// Logline: Render high-definition visual cards for user turns, tool invocations, approval modals, and welcome dashboards.
//
// Setup: Terminal card renderer supporting 24-bit ANSI styling, plain ASCII fallback, and responsive width.
//
// Beats:
//   1. Render user turn prompts and assistant text cards.
//   2. Render tool execution status badges and approval modals.
//   3. Render welcome dashboard card with quick-start guidance.

import "theme.oo";
import "pane.oo";
import "ui/cards/card_thought.oo";

fn pad_r(s: String, w: Int) -> String {
    let mut out: String = s;
    while chars_len(out) < w { out = out + " "; }
    if chars_len(out) > w { return str_slice(out, 0, w); }
    return out;
}

fn u_dashes(n: Int) -> String {
    let mut s: String = "";
    let mut i: Int = 0;
    while i < n { s = s + "─"; i = i + 1; }
    return s;
}

pub fn card_tool(theme: String, color: Bool, mark: String, name: String, target: String, note: String) -> String {
    let mut mk: String = "";
    let mut glyph: String = "";
    if mark == "*" { mk = theme_color(theme, "accent"); glyph = "●"; }
    else if mark == "." { mk = theme_color(theme, "success"); glyph = "✔"; }
    else if mark == "?" { mk = theme_color(theme, "accent"); glyph = "?"; }
    else if mark == "x" { mk = theme_color(theme, "error"); glyph = "✖"; }
    else { mk = theme_color(theme, "dim"); glyph = mark; }

    if !color {
        let mut s_p: String = "  " + glyph + " [" + pad_r(name, 5) + "] " + pad_r(target, 36);
        if note != "" { s_p = s_p + " " + note; }
        return s_p;
    }

    let mut s: String = "  " + ansi_fg(color, mk) + glyph + ansi_reset(color) + " ";
    s = s + ansi_fg(color, theme_color(theme, "accent")) + ansi_bold(color) + "[" + pad_r(name, 5) + "]" + ansi_reset(color) + " ";
    s = s + ansi_fg(color, theme_color(theme, "text")) + pad_r(target, 36) + ansi_reset(color);
    if note != "" {
        s = s + " " + ansi_fg(color, theme_color(theme, "dim")) + note + ansi_reset(color);
    }
    return s;
}

pub fn card_you(line: String) -> String {
    return "  ❯ " + line;
}

pub fn card_you_styled(theme: String, color: Bool, line: String) -> String {
    if !color { return "  ❯ " + line; }
    return ansi_fg(color, theme_color(theme, "accent")) + ansi_bold(color) + "  ❯ " + ansi_reset(color) + ansi_fg(color, theme_color(theme, "text")) + line + ansi_reset(color);
}

pub fn card_say(line: String) -> String {
    return "    " + line;
}

pub fn card_say_styled(theme: String, color: Bool, line: String) -> String {
    if !color { return "    " + line; }
    return "    " + ansi_fg(color, theme_color(theme, "text")) + line + ansi_reset(color);
}

pub fn card_ask(theme: String, color: Bool, name: String, target: String, note: String) -> String {
    let err: String = theme_color(theme, "error");
    let acc: String = theme_color(theme, "accent");

    if !color {
        let bar_p: String = "+--------------------------------------------------------------+";
        let mut sp: String = "  " + bar_p + "\n";
        sp = sp + "  | ASK  " + pad_r(name, 6) + " " + pad_r(target, 44) + " |\n";
        if note != "" { sp = sp + "  |      " + pad_r(note, 51) + " |\n"; }
        sp = sp + "  |  y yes    n no    a always    d deny                       |\n";
        sp = sp + "  " + bar_p;
        return sp;
    }

    let top: String = ansi_fg(color, err) + "  ╭─ " + ansi_bold(color) + "APPROVAL REQUIRED" + ansi_reset(color) + ansi_fg(color, err) + " ────────────────────────────────────────╮" + ansi_reset(color) + "\n";
    let l1: String = ansi_fg(color, err) + "  │" + ansi_reset(color) + "  " + ansi_bold(color) + ansi_fg(color, acc) + "Tool:   " + ansi_reset(color) + ansi_fg(color, theme_color(theme, "text")) + pad_r(name + " " + target, 48) + ansi_reset(color) + ansi_fg(color, err) + "│" + ansi_reset(color) + "\n";
    let mut l2: String = "";
    if note != "" {
        l2 = ansi_fg(color, err) + "  │" + ansi_reset(color) + "  " + ansi_fg(color, theme_color(theme, "dim")) + pad_r("Note:   " + note, 56) + ansi_reset(color) + ansi_fg(color, err) + "│" + ansi_reset(color) + "\n";
    }
    let l3: String = ansi_fg(color, err) + "  │" + ansi_reset(color) + "  " + ansi_fg(color, acc) + pad_r("Action: [y]es   [n]o   [a]lways   [d]eny", 56) + ansi_reset(color) + ansi_fg(color, err) + "│" + ansi_reset(color) + "\n";
    let bot: String = ansi_fg(color, err) + "  ╰────────────────────────────────────────────────────────────╯" + ansi_reset(color);
    return top + l1 + l2 + l3 + bot;
}

pub fn card_think(theme: String, color: Bool, model: String) -> String {
    let dim: String = theme_color(theme, "dim");
    let acc: String = theme_color(theme, "accent");
    return "  " + ansi_fg(color, acc) + "●" + ansi_reset(color) + " " + ansi_fg(color, dim) + "thinking (" + model + ")..." + ansi_reset(color);
}

pub fn card_thought(theme: String, color: Bool, thoughts: String, cols: Int) -> String {
    return card_thought_render(theme, color, thoughts, false, cols);
}

pub fn card_thought_collapsed(theme: String, color: Bool, thoughts: String, cols: Int) -> String {
    return card_thought_render(theme, color, thoughts, true, cols);
}

pub fn card_welcome_pane(theme: String, color: Bool, cols: Int, ver: String, mode: String, perm: String, cwd: String, provider: String, model: String, brief: Bool, mcp: Bool) -> Pane {
    let mut p: Pane = pane_new();
    let border: String = theme_color(theme, "borderMuted");

    let mut w: Int = cols - 6;
    if w < 54 { w = 54; }
    if w > 74 { w = 74; }

    let t_title: String = "openOODA TUI " + ver;
    let dashes_len: Int = w - chars_len(t_title) - 6;
    let mut top_rule: String = "  ╭─ " + t_title + " " + u_dashes(dashes_len) + "╮";
    if color {
        top_rule = "  " + ansi_fg(color, border) + "╭─ " + ansi_reset(color) + ansi_fg(color, theme_color(theme, "accent")) + ansi_bold(color) + t_title + ansi_reset(color) + " " + ansi_fg(color, border) + u_dashes(dashes_len) + "╮" + ansi_reset(color);
    }
    p = pane_append(p, top_rule);

    let row1: String = "  Mode: " + mode + "/" + perm + "    Theme: " + theme;
    p = pane_append(p, format_card_row(theme, color, "text", row1, w));

    let mut cwd_disp: String = cwd;
    if chars_len(cwd_disp) > w - 12 {
        let clen: Int = chars_len(cwd_disp);
        cwd_disp = "..." + str_slice(cwd_disp, clen - (w - 15), clen);
    }
    let row2: String = "  CWD:  " + cwd_disp;
    p = pane_append(p, format_card_row(theme, color, "dim", row2, w));

    let mut llm_desc: String = "offline  ·  use /login <provider> <key>";
    if provider != "" { llm_desc = provider + "/" + model + " (active)"; }
    let row3: String = "  LLM:  " + llm_desc;
    p = pane_append(p, format_card_row(theme, color, "text", row3, w));

    let mcp_st: String = if mcp { "online" } else { "offline" };
    let brief_st: String = if brief { "AGENTS.md active" } else { "none" };
    let row4: String = "  MCP:  " + mcp_st + "    Spec: " + brief_st;
    p = pane_append(p, format_card_row(theme, color, "muted", row4, w));

    let row_tools: String = if color { "  Tools: read · grep · glob · write · bash · mcp" } else { "  Tools: read grep glob write bash mcp" };
    p = pane_append(p, format_card_row(theme, color, "dim", row_tools, w));

    p = pane_append(p, format_card_row(theme, color, "text", " ", w));
    p = pane_append(p, format_card_row(theme, color, "accent", "  Quick Start:", w));
    p = pane_append(p, format_card_row(theme, color, "text", "    /login <provider> <key>  Connect to AI model", w));
    p = pane_append(p, format_card_row(theme, color, "text", "    /preset <name>           Switch preset (kernel, frontend, zen)", w));
    p = pane_append(p, format_card_row(theme, color, "text", "    /tools                   Inspect sandboxed native tools", w));
    p = pane_append(p, format_card_row(theme, color, "text", "    /help                    Command reference & keybindings", w));

    let bot_rule: String = if color {
        "  " + ansi_fg(color, border) + "╰" + u_dashes(w - 2) + "╯" + ansi_reset(color)
    } else {
        "  ╰" + u_dashes(w - 2) + "╯"
    };
    p = pane_append(p, bot_rule);
    return p;
}

fn format_card_row(theme: String, color: Bool, token: String, text: String, width: Int) -> String {
    let border: String = theme_color(theme, "borderMuted");
    let content_color: String = theme_color(theme, token);
    let inner_w: Int = width - 4;
    let vis_len: Int = chars_len(text);
    let mut fill: Int = inner_w - vis_len;
    if fill < 0 { fill = 0; }
    let mut spaces: String = "";
    let mut i: Int = 0;
    while i < fill { spaces = spaces + " "; i = i + 1; }

    if !color {
        return "  | " + text + spaces + " |";
    }
    return "  " + ansi_fg(color, border) + "│ " + ansi_reset(color) + ansi_fg(color, content_color) + text + spaces + ansi_reset(color) + " " + ansi_fg(color, border) + "│" + ansi_reset(color);
}
