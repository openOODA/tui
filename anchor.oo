// # OODA-TUI - Anchor for Agents
//
// Logline: Front door for the openOODA/tui/ harness repo. Imports all child anchors; code modules live at the repo root.
//
// Setup: Pure structural file. api_surface=2 (root + token subdir).
//
// Beats:
//   1. Decoupled micro-kernel core/ and master plugins/ subsystems alongside root modules (main.oo, repl.oo, llm_exec.oo, config_io.oo).
//   2. token/ holds the 13 cmd_*.oo files moved from ooda/token/ per rules.oot 1.14 split (Phase 5).
//   3. themes/ holds the default theme (1982.oo) and any future themes.
//   4. qa/ has the hostile probes and double-run tests.
//   5. docs/ has the ASD-STE100 specs in .oot form.
//   6. audit/ has the historical audits (v0.1 ships with the anchor only).
//   7. examples/ has sample configs and session layouts.
//   8. .github/workflows/ci.yml is the build, test, verify, release entry point per rules.oot 1.15 and 1.24.
//   9. No VERSION file (rules.oot 1.24). Version comes from git tags via auto-release.
//   10. Layer 3 (Operational Logistics) per rules.oot 1.23. Depends on Layer 2 only.

import "token/anchor.oo";
import "themes/anchor.oo";
import "docs/anchor.oo";
import "qa/anchor.oo";
import "audit/anchor.oo";
import "examples/anchor.oo";
import "core/anchor.oo";
import "plugins/anchor.oo";
import "tools/anchor.oo";

import "version.oo";

pub fn ooda_tui_anchor_version() -> String {
    return ooda_tui_version();
}
