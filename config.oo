// # config.oo - Config Parser and Writer
//
// Logline: Parse and write ~/.config/ooda-tui/config.oot (mode 0600). Multi-provider format with provider blocks, defaults, and teamwork assignment.
//
// Setup: Imports std/fs/file. Reads/writes the user config file. Fails closed on malformed input.
//
// Beats:
//   1. Provider record: {name, type, key, url, models}.
//   2. Provider list per block (provider anthropic ... key ... models ...).
//   3. Top-level keys: default_provider, default_model, permission_mode, compact_threshold, theme, teamwork_agents, teamwork_providers.
//   4. File mode 0600 enforced on write.

import "std/fs/file/path.oo";
import "std/fs/file/file_reader.oo";
import "std/fs/process/env.oo";

type Provider = struct {
    name: String,
    ptype: String,
    key: String,
    url: String,
    models: List[String]
};

type Config = struct {
    providers: List[Provider],
    default_provider: String,
    default_model: String,
    permission_mode: String,
    compact_threshold: String,
    theme: String,
    teamwork_agents: Int
};

pub fn provider_new(name: String, ptype: String) -> Provider {
    return Provider { name: name, ptype: ptype, key: "", url: "", models: list_new() };
}

pub fn config_default() -> Config {
    return Config {
        providers: list_new(),
        default_provider: "",
        default_model: "",
        permission_mode: "prompt",
        compact_threshold: "0.7",
        theme: "1982",
        teamwork_agents: 4
    };
}

pub fn config_has_provider(cfg: Config, name: String) -> Bool {
    let n: Int = list_len(cfg.providers);
    let mut i: Int = 0;
    let mut found: Bool = false;
    while i < n {
        let p: Provider = list_get(cfg.providers, i);
        if p.name == name { found = true; i = n; }
        i = i + 1;
    }
    return found;
}

pub fn config_add_provider(cfg: Config, name: String, ptype: String, key: String, url: String, models: List[String]) -> Config {
    let p: Provider = Provider { name: name, ptype: ptype, key: key, url: url, models: models };
    cfg.providers = list_push(cfg.providers, p);
    return cfg;
}

pub fn config_remove_provider(cfg: Config, name: String) -> Config {
    let mut out: List[Provider] = list_new();
    let n: Int = list_len(cfg.providers);
    let mut i: Int = 0;
    while i < n {
        let p: Provider = list_get(cfg.providers, i);
        if p.name != name { out = list_push(out, p); }
        i = i + 1;
    }
    cfg.providers = out;
    return cfg;
}

fn skip_blank_or_comment(line: String) -> Bool {
    if chars_len(line) == 0 { return true; }
    if str_starts_with(line, "#") { return true; }
    return false;
}

fn starts_with_word(line: String, word: String) -> Bool {
    return str_starts_with(line, word);
}

fn slice_after(line: String, after: Int) -> String {
    return str_trim(str_slice(line, after, chars_len(line)));
}

fn extract_quoted(s: String) -> String {
    let mut r: String = s;
    if str_starts_with(r, "\"") && str_ends_with(r, "\"") { r = str_slice(r, 1, chars_len(r) - 1); }
    return r;
}

pub fn config_parse(content: String) -> Result[Config, String] {
    let mut cfg: Config = config_default();
    let mut current: Provider = provider_new("", "");
    let mut in_block: Bool = false;
    let lines: List[String] = str_split_lines(content);
    let n: Int = list_len(lines);
    let mut i: Int = 0;
    while i < n {
        let raw: String = list_get(lines, i);
        let line: String = str_trim(raw);
        if skip_blank_or_comment(line) { i = i + 1; }
        else {
            if str_starts_with(line, "provider ") {
                if in_block { cfg = config_add_provider(cfg, current.name, current.ptype, current.key, current.url, current.models); }
                current = provider_new(slice_after(line, 9), "cloud");
                in_block = true;
            } else if in_block && starts_with_word(line, "type") {
                current.ptype = slice_after(line, 4);
            } else if in_block && starts_with_word(line, "key") {
                current.key = extract_quoted(slice_after(line, 3));
            } else if in_block && starts_with_word(line, "url") {
                current.url = extract_quoted(slice_after(line, 3));
            } else if in_block && starts_with_word(line, "models") {
                current.models = str_split_comma(extract_bracketed(slice_after(line, 6)));
            } else if starts_with_word(line, "default_provider") {
                cfg.default_provider = slice_after(line, 16);
            } else if starts_with_word(line, "default_model") {
                cfg.default_model = slice_after(line, 13);
            } else if starts_with_word(line, "permission_mode") {
                cfg.permission_mode = slice_after(line, 16);
            } else if starts_with_word(line, "compact_threshold") {
                cfg.compact_threshold = slice_after(line, 18);
            } else if starts_with_word(line, "theme") {
                cfg.theme = slice_after(line, 5);
            } else if starts_with_word(line, "teamwork_agents") {
                cfg.teamwork_agents = str_to_int(slice_after(line, 15));
            }
            i = i + 1;
        }
    }
    if in_block { cfg = config_add_provider(cfg, current.name, current.ptype, current.key, current.url, current.models); }
    return Ok(cfg);
}

fn extract_bracketed(s: String) -> String {
    let mut r: String = s;
    if str_starts_with(r, "[") && str_ends_with(r, "]") { r = str_slice(r, 1, chars_len(r) - 1); }
    return r;
}

pub fn config_serialize(cfg: Config) -> String {
    let mut out: String = "# ooda-tui config\n\n";
    let n: Int = list_len(cfg.providers);
    let mut i: Int = 0;
    while i < n {
        let p: Provider = list_get(cfg.providers, i);
        out = out + "provider " + p.name + "\n";
        out = out + "  type = " + p.ptype + "\n";
        if p.ptype == "cloud" {
            out = out + "  key = \"" + p.key + "\"\n";
        } else {
            out = out + "  url = \"" + p.url + "\"\n";
        }
        out = out + "  models = [" + str_join_comma(p.models) + "]\n\n";
        i = i + 1;
    }
    if cfg.default_provider != "" { out = out + "default_provider = " + cfg.default_provider + "\n"; }
    if cfg.default_model != "" { out = out + "default_model = " + cfg.default_model + "\n"; }
    out = out + "permission_mode = " + cfg.permission_mode + "\n";
    out = out + "compact_threshold = " + cfg.compact_threshold + "\n";
    out = out + "theme = " + cfg.theme + "\n";
    out = out + "teamwork_agents = " + int_to_str(cfg.teamwork_agents) + "\n";
    return out;
}

pub fn config_path(env: &EnvCap) -> String {
    let hr: Result[String, String] = env_get(env, "HOME");
    let home: String = match hr { Ok(s) => s, Err(_) => "" };
    let dir: String = path_join(home, ".config/ooda-tui");
    return path_join(dir, "config.oot");
}

// Local str_split_lines stub (matches markdown.oo/diff.oo/tool_card.oo stubs).
fn str_split_lines(s: String) -> List[String] {
    let mut out: List[String] = list_new();
    let mut cur: String = "";
    let len: Int = chars_len(s);
    let mut i: Int = 0;
    while i < len {
        let c: String = char_at(s, i);
        if c == "\n" { out = list_push(out, cur); cur = ""; }
        else if c != "\r" { cur = cur + c; }
        i = i + 1;
    }
    if cur != "" || len == 0 { out = list_push(out, cur); }
    return out;
}

// Local str_split_comma stub: split a comma-separated list, trim whitespace.
fn str_split_comma(s: String) -> List[String] {
    let mut out: List[String] = list_new();
    let mut cur: String = "";
    let len: Int = chars_len(s);
    let mut i: Int = 0;
    while i < len {
        let c: String = char_at(s, i);
        if c == "," { out = list_push(out, str_trim(cur)); cur = ""; }
        else { cur = cur + c; }
        i = i + 1;
    }
    if cur != "" || len == 0 { out = list_push(out, str_trim(cur)); }
    return out;
}

// Local str_to_int stub: parse a non-negative integer. Returns 0 on
// invalid input. Used by config.oo to parse teamwork_agents.
fn str_to_int(s: String) -> Int {
    let mut acc: Int = 0;
    let len: Int = chars_len(s);
    let mut i: Int = 0;
    while i < len {
        let c: String = char_at(s, i);
        let digit: Int = if c == "0" { 0 } else if c == "1" { 1 } else if c == "2" { 2 } else if c == "3" { 3 } else if c == "4" { 4 } else if c == "5" { 5 } else if c == "6" { 6 } else if c == "7" { 7 } else if c == "8" { 8 } else if c == "9" { 9 } else { -1 };
        if digit >= 0 { acc = acc * 10 + digit; }
        i = i + 1;
    }
    return acc;
}

// Local str_join_comma stub: join a list of strings with comma separator.
fn str_join_comma(items: List[String]) -> String {
    let mut out: String = "";
    let n: Int = list_len(items);
    let mut i: Int = 0;
    while i < n {
        if i > 0 { out = out + ", "; }
        out = out + list_get(items, i);
        i = i + 1;
    }
    return out;
}

// Local int_to_str stub (matches theme.oo/markdown.oo/render.oo probes).
fn int_to_str(n: Int) -> String {
    if n < 0 { return "0"; }
    if n == 0 { return "0"; }
    let digits: String = "0123456789";
    let mut v: Int = n;
    let mut rev: String = "";
    while v > 0 { let d: Int = v - (v / 10) * 10; rev = rev + char_at(digits, d); v = v / 10; }
    let mut out: String = "";
    let mut k: Int = chars_len(rev) - 1;
    while k >= 0 { out = out + char_at(rev, k); k = k - 1; }
    return out;
}
