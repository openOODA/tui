// # input.oo - Compose box (line-mode)
//
// Logline: Draw a compose rule then a prompt with no trailing newline so cooked stdin types on that line.
//
// Setup: Last surface in the chrome. Tokens: accent, muted.
//
// Beats:
//   1. A one-line rule labels the box (enter sends, slash commands).
//   2. Prompt is "> " with no fake cursor and no newline.

import "theme.oo";

pub fn input_render(theme: String, buf: String, color: Bool, cols: Int) -> String {
    let accent: String = theme_color(theme, "accent");
    let muted: String = theme_color(theme, "muted");
    let mut label: String = "+ compose · enter sends · /help · /exit";
    if buf == "ask" { label = "+ APPROVE · y yes · n no · a always · d deny"; }
    let mut s: String = ansi_fg(color, muted) + label + ansi_reset(color);
    let mut pad: Int = cols - chars_len(label);
    if pad < 1 { pad = 1; }
    let mut k: Int = 0;
    while k < pad { s = s + " "; k = k + 1; }
    s = s + "\n";
    s = s + ansi_fg(color, accent) + "> " + ansi_reset(color);
    let _: String = buf;
    return s;
}

pub fn input_height() -> Int {
    return 2;
}
